---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeedExplorer from '../components/SeedExplorer.astro';
import SourceList from '../components/SourceList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { seeds, site, sources } from '../lib/content';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../lib/seo';

const metadata = pageSeo.seeds;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: metadata.h1,
    description: metadata.description,
    url: absoluteUrl(metadata.canonicalPath),
    dateModified: site.checkedAt,
  },
  buildBreadcrumbSchema([
    { name: 'Greedy Growers Hub', path: '/' },
    { name: 'Greedy Growers Seeds', path: metadata.canonicalPath },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Greedy Growers seed records',
    numberOfItems: seeds.length,
    itemListElement: seeds.map((seed, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Thing',
        name: seed.name,
        description: seed.notes,
      },
    })),
  },
];
---

<BaseLayout
  title={metadata.title}
  description={metadata.description}
  canonicalPath={metadata.canonicalPath}
  schema={schemas}
>
  <section class="mx-auto max-w-6xl px-5 pb-16 pt-14 sm:px-8 sm:pt-20">
    <div class="max-w-3xl">
      <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Evidence-first database</p>
      <h1 class="mt-4 text-4xl font-bold tracking-[-.04em] sm:text-6xl">{metadata.h1}</h1>
      <p class="mt-5 text-lg leading-8 text-sand-300">Filter and compare the public facts we can currently support. A blank number is marked “Not verified” until an in-game capture or reliable public source confirms it.</p>
    </div>

    <section class="mt-10" aria-labelledby="seed-records-title">
      <div id="seed-records-title"><SectionHeading eyebrow="Recorded evidence" title="Greedy Growers seed records" description="Sort the records we can currently source. Unknown costs, values, and growth times remain visibly unverified." /></div>
      <div class="mt-8"><SeedExplorer items={seeds} /></div>
    </section>

    <section class="mt-14">
      <SectionHeading eyebrow="Read the numbers" title="How to read Greedy Growers seed stats" description="Use the same definitions for every recorded run before comparing one seed with another." />
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-semibold">What profit per minute means</h3><p class="mt-3 text-sm leading-6 text-sand-300">Subtract the seed cost from the harvest value, then divide the successful profit by the recorded wait time.</p></article>
        <article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-semibold">How failed runs change seed profit</h3><p class="mt-3 text-sm leading-6 text-sand-300">Each failed seed increases the harvest value needed to break even. Record failures instead of hiding them.</p></article>
        <article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-semibold">Growth time versus harvest value</h3><p class="mt-3 text-sm leading-6 text-sand-300">A higher harvest value is not automatically better when it takes longer or follows repeated failed attempts.</p></article>
      </div>
      <nav class="mt-8 flex flex-wrap gap-3" aria-label="Continue planning with seed data"><a href="/calculator/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Plug seed data into the profit calculator</a><a href="/beginner-guide/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Follow the first-harvest guide</a><a href="/codes/" class="rounded-md border border-line px-5 py-3 text-sm font-bold text-sand-100 no-underline">Check current Greedy Growers codes</a></nav>
    </section>
    <div class="mt-10"><SourceList items={sources.filter((source) => ['roblox-official', 'gg-wiki'].includes(source.id))} title="Sources used for seed records" /></div>
  </section>
</BaseLayout>
