---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeStatus from '../../components/CodeStatus.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import communityLinks from '../../data/community-links.json';
import { evidenceByPage } from '../../data/evidence';
import { codes, site, sources } from '../../lib/content';
import { absoluteUrl, buildBreadcrumbSchema, codeLanguageAlternates, localizedPageSeo } from '../../lib/seo';

const activeCodes = codes.filter((code) => code.status === 'active');
const expiredCodes = codes.filter((code) => code.status === 'expired');
const metadata = localizedPageSeo.viCodes;
const checkedLabel = new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${evidenceByPage.codes.lastChecked}T00:00:00Z`));
const discordCheckedLabel = new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${communityLinks.discord.checkedAt}T00:00:00Z`));

const redeemSteps = [
  ['Vào đúng trải nghiệm chính thức', 'Mở Greedy Growers từ trang Roblox chính thức và vào một máy chủ bình thường.'],
  ['Mở Settings', 'Các nguồn theo dõi công khai báo cáo ô nhập code nằm trong Settings; giao diện này chưa được dự án kiểm chứng bằng ảnh gốc trong game.'],
  ['Dán chính xác code', 'Giữ nguyên chữ hoa, chữ thường và khoảng trắng như nguồn do nhà phát triển sở hữu đã đăng.'],
  ['Gửi và kiểm tra phần thưởng', 'Chỉ coi code là hợp lệ khi game chấp nhận chuỗi đó và phần thưởng xuất hiện trong phiên chơi hiện tại.'],
];
const failureReasons = [
  ['Code không có nguồn đáng tin', 'Không dùng chuỗi phần thưởng hấp dẫn nhưng không có dấu vết nguồn hoặc kết quả trong game.'],
  ['Code đã hết hạn', 'Code sự kiện, cập nhật hoặc cột mốc có thể bị gỡ nhanh, vì vậy luôn kiểm tra ngày.'],
  ['Code bị sao chép sai', 'Khoảng trắng thừa, sai chữ hoa hoặc ký tự giống nhau có thể làm code thất bại.'],
  ['Nguồn không phải chính thức', 'Trang Roblox hoặc thông báo trong game do nhà phát triển sở hữu đáng tin hơn danh sách sao chép.'],
];
const faqs = [
  ['"Nhà trồng tham lam" có phải là Greedy Growers không?', 'Đây là một bản dịch sát nghĩa mà người chơi có thể dùng để tìm kiếm. Tên chính thức của trải nghiệm Roblox vẫn là Greedy Growers.'],
  ['"Những người trồng tham lam" có phải cùng một trò chơi không?', 'Có thể người tìm kiếm đang nói đến Greedy Growers, nhưng hãy luôn kiểm tra tên nhà phát triển và liên kết Roblox chính thức trước khi tham gia.'],
  ['Hiện có code Greedy Growers nào hoạt động không?', `Chưa có code đang hoạt động nào được trang này xác minh tính đến ${checkedLabel}.`],
  ['Ô nhập code Greedy Growers ở đâu?', 'Hai nguồn thứ cấp báo cáo ô nhập nằm trong Settings. Thông tin này vẫn được ghi là báo cáo cho đến khi có ảnh hoặc phiên chơi hiện tại để xác minh.'],
];
const checkedSources = sources.filter((source) => ['roblox-official', 'pro-game-guides-codes', 'mrguider-codes'].includes(source.id));
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: metadata.h1,
    description: metadata.description,
    url: absoluteUrl(metadata.canonicalPath),
    inLanguage: 'vi',
    dateModified: evidenceByPage.codes.lastChecked,
  },
  buildBreadcrumbSchema([
    { name: 'Greedy Growers Hub', path: '/' },
    { name: 'Code Greedy Growers', path: metadata.canonicalPath },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'vi',
    mainEntity: faqs.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schemas} lang="vi" alternates={codeLanguageAlternates}>
  <section class="border-b border-line bg-ink-900/60">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-leaf-400">Hướng dẫn code Roblox</p>
        <a href="/codes/" hreflang="en" lang="en" class="rounded-full border border-line px-3 py-1.5 text-xs font-bold text-sand-100 no-underline hover:border-leaf-500/50">English version</a>
      </div>
      <h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-sand-300">Kiểm tra kết luận hiện tại trước khi nhập bất kỳ chuỗi nào. Trang này tách riêng code đang hoạt động, code hết hạn, báo cáo chưa xác minh và kết quả trong game.</p>
      <div class="mt-4 rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-[13px] leading-relaxed text-sand-300" role="note" aria-label="Trạng thái bằng chứng của trang">
        <div class="flex flex-wrap gap-x-5 gap-y-2"><span><strong class="text-sand-100">Phiên bản:</strong> {evidenceByPage.codes.version}</span><span><strong class="text-sand-100">Nguồn:</strong> {evidenceByPage.codes.sourceCount}</span><span><strong class="text-sand-100">Mức độ:</strong> Chưa xác minh trong game</span><span><strong class="text-sand-100">Kiểm tra lần cuối:</strong> {checkedLabel}</span></div>
        <p class="mt-1 text-xs text-sand-300/70">Khoảng trống: chưa xác nhận code đang hoạt động · không có code hiện tại không có nghĩa là code chưa từng tồn tại</p>
      </div>
      <div class="mt-6 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4" aria-label="Tóm tắt code Greedy Growers hiện tại">
        <p class="bg-ink-950 px-4 py-3 font-mono text-xs text-sand-100">Đang hoạt động: {activeCodes.length}</p>
        <p class="bg-ink-950 px-4 py-3 font-mono text-xs text-sand-100">Đã hết hạn: {expiredCodes.length}</p>
        <p class="bg-ink-950 px-4 py-3 font-mono text-xs text-sand-100">Nhập code: Settings (được báo cáo, chưa kiểm chứng trong game)</p>
        <p class="bg-ink-950 px-4 py-3 font-mono text-xs text-sand-100">Kiểm tra: <time datetime={evidenceByPage.codes.lastChecked}>{checkedLabel}</time></p>
      </div>
      <div class="mt-7 flex flex-wrap gap-3"><a href="#trang-thai" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Xem trạng thái code</a><a href={site.officialGameUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Mở Roblox <Icon name="external" size={15}/></a></div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl space-y-16 px-4 py-16 sm:px-6 lg:px-8">
    <section id="trang-thai" class="scroll-mt-24">
      <SectionHeading eyebrow="Kết luận hiện tại" title="Có code Greedy Growers nào đang hoạt động không?" description={`Không có code đang hoạt động nào được xác minh tính đến ${checkedLabel}. Hai nguồn theo dõi hiện tại đều hiển thị danh sách trống và dự án chưa có lần nhập code thành công được ghi lại trong game.`}/>
      <aside class="mt-8 rounded-2xl border border-leaf-500/25 bg-leaf-500/[.055] p-6"><p class="font-display text-2xl font-bold text-white">Kết luận đã kiểm tra: 0 code hoạt động</p><p class="mt-3 max-w-3xl text-sm leading-6 text-sand-300">Số 0 là kết quả có ngày kiểm tra, không phải khẳng định rằng game chưa từng có code.</p></aside>
    </section>

    <section id="code-hoat-dong" class="scroll-mt-24">
      <SectionHeading eyebrow="Danh sách hiện tại" title="Tất cả code Greedy Growers đang hoạt động" description="Danh sách sẽ để trống cho đến khi một code vượt qua kiểm tra nguồn và kiểm chứng trong game."/>
      <div class="mt-8"><CodeStatus locale="vi" /></div>
    </section>

    <section id="code-het-han" class="scroll-mt-24">
      <SectionHeading eyebrow="Lịch sử" title="Code Greedy Growers đã hết hạn" description="Dự án chưa có bản ghi code hết hạn nào từng hoạt động và có thể truy xuất nguồn."/>
      <div class="mt-8 rounded-xl border border-line bg-ink-900 p-6"><p class="text-sm leading-6 text-sand-300">Đã hết hạn: {expiredCodes.length}. Bản ghi sau này phải giữ lại code chính xác, phần thưởng, nguồn ban đầu và ngày code ngừng hoạt động.</p></div>
    </section>

    <section id="cach-nhap" class="scroll-mt-24">
      <SectionHeading eyebrow="Đường dẫn được báo cáo" title="Cách nhập code trong Greedy Growers" description="Các nguồn theo dõi hiện tại báo cáo đường dẫn qua Settings. Thông tin này chưa phải bằng chứng rằng đang có code hoạt động."/>
      <ol class="mt-8 grid gap-4 md:grid-cols-2">{redeemSteps.map(([title, description], index) => <li class="rounded-xl border border-line bg-ink-900 p-5"><div class="flex items-center gap-3"><span class="grid size-8 place-items-center rounded-md bg-leaf-500 font-mono text-xs font-bold text-ink-950">{index + 1}</span><h3 class="font-display font-bold text-white">{title}</h3></div><p class="mt-4 text-sm leading-6 text-sand-300">{description}</p></li>)}</ol>
    </section>

    <section id="khong-hoat-dong" class="scroll-mt-24">
      <SectionHeading eyebrow="Khắc phục lỗi" title="Tại sao code Greedy Growers không hoạt động?" description="Hãy loại trừ code bịa đặt, code hết hạn, lỗi nhập và nguồn yếu trước khi thử lại."/>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">{failureReasons.map(([title, description]) => <article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-display font-bold text-white">{title}</h3><p class="mt-3 text-sm leading-6 text-sand-300">{description}</p></article>)}</div>
    </section>

    <section id="nguon-code" class="scroll-mt-24">
      <SectionHeading eyebrow="Nguồn phát hành" title="Code Greedy Growers mới được phát hành ở đâu?" description="Bắt đầu từ các bề mặt Roblox do nhà phát triển sở hữu. Trang theo dõi thứ cấp chỉ là đầu mối và liên kết Discord sao chép không tự trở thành chính thức."/>
      <ul class="mt-8 grid gap-3 rounded-xl border border-line bg-ink-900/70 p-5 sm:p-6">{checkedSources.map((source) => <li class="flex flex-col gap-2 rounded-lg border border-line/70 bg-ink-950/50 p-4 sm:flex-row sm:items-center sm:justify-between"><a href={source.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-semibold text-sand-100 hover:text-leaf-400">{source.name} <Icon name="external" size={13}/></a><span class="text-xs font-bold text-leaf-400">{source.trust === 'official' ? 'Chính thức' : 'Nguồn tham khảo'}</span></li>)}</ul>
      <aside class="mt-5 rounded-xl border border-amber-400/25 bg-amber-400/[.055] p-5" role="note">
        <p class="font-display font-bold text-white">Discord chính thức: Chưa xác minh vào ngày {discordCheckedLabel}</p>
        <p class="mt-2 text-sm leading-6 text-sand-300">Không thể đối chiếu lời mời do nhà phát triển sở hữu từ các bề mặt Roblox công khai. Trang này sẽ không đăng liên kết Discord cho đến khi có nguồn chính thức có thể tái kiểm tra.</p>
      </aside>
    </section>

    <section>
      <SectionHeading eyebrow="Câu hỏi thường gặp" title="Câu hỏi về code Greedy Growers"/>
      <div class="mt-8 grid gap-3">{faqs.map(([question, answer]) => <details class="rounded-xl border border-line bg-ink-900 p-5"><summary class="flex min-h-11 cursor-pointer items-center font-display font-bold text-white">{question}</summary><p class="mt-4 text-sm leading-6 text-sand-300">{answer}</p></details>)}</div>
      <nav class="mt-8 flex flex-wrap gap-3" aria-label="Tiếp tục với công cụ Greedy Growers"><a href="/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Mở công cụ tính lợi nhuận</a><a href="/codes/" hreflang="en" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Đọc trang tiếng Anh</a></nav>
    </section>
  </div>
</BaseLayout>
