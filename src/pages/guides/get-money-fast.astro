---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlayerTestCard from '../../components/PlayerTestCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../../lib/seo';

const metadata = pageSeo.getMoneyFast;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: metadata.h1, description: metadata.description, mainEntityOfPage: absoluteUrl(metadata.canonicalPath) },
  buildBreadcrumbSchema([{ name: 'Greedy Growers Calculator', path: '/' }, { name: 'Guides', path: '/guides/' }, { name: 'Get Money Fast', path: metadata.canonicalPath }]),
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schema}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-4xl"><p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Protect capital before chasing height</p><h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1><p class="mt-5 text-lg leading-8 text-sand-300">Fast money starts with repeatable cash-outs. A spectacular tree that gets destroyed before harvest earns nothing and delays the next purchase.</p></div>

    <section class="mt-16"><SectionHeading eyebrow="Capital floor" title="Protect your starting Greedy Growers coins" description="Keep enough coins for more than one attempt so a single lightning loss does not stop the whole progression loop."/><div class="mt-8 grid gap-4 md:grid-cols-3"><article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Bank the first clean harvest</h3><p class="mt-3 text-sm leading-6 text-sand-300">Learn buy, plant, wait, and harvest before extending the timer or buying a seed that consumes most of your balance.</p></article><article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Keep a failure reserve</h3><p class="mt-3 text-sm leading-6 text-sand-300">Hold enough for at least one replacement seed and any fertilizer you intend to use on the next attempt.</p></article><article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Measure, then upgrade</h3><p class="mt-3 text-sm leading-6 text-sand-300">Use several similar runs to decide whether an upgrade improves repeatable profit instead of one lucky result.</p></article></div></section>

    <section class="mt-16"><SectionHeading eyebrow="Spend order" title="Seed, fertilizer, and Tickets investment order" description="The exact unlock rules still need verification, but the financial order can stay conservative."/><ol class="mt-8 grid gap-4 md:grid-cols-2"><li class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">1. Fund the next seed</h3><p class="mt-2 text-sm text-sand-300">Do not spend the coin floor required to keep planting.</p></li><li class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">2. Confirm a repeatable harvest</h3><p class="mt-2 text-sm text-sand-300">Record the same seed and wait target more than once.</p></li><li class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">3. Test fertilizer separately</h3><p class="mt-2 text-sm text-sand-300">Include fertilizer cost in every failed attempt, not only the successful run.</p></li><li class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">4. Verify Tickets before planning around them</h3><p class="mt-2 text-sm text-sand-300">Source, use location, and limits remain update-sensitive.</p></li></ol></section>

    <section class="mt-16"><SectionHeading eyebrow="Recovery" title="How to recover after a lightning loss" description="A failed run changes the break-even line. Do not chase the loss with an even larger unmeasured gamble."/><div class="mt-8 rounded-2xl border border-leaf-500/25 bg-leaf-500/[.045] p-6"><h3 class="font-display text-xl font-bold text-white">Use total attempt cost</h3><p class="mt-3 max-w-3xl text-sm leading-6 text-sand-300">If one attempt costs 100 coins and lightning destroys two runs, the next successful harvest must exceed 300 coins before the sequence is profitable. Enter failed runs in the <a href="/" class="font-bold text-leaf-400">Calculator</a> instead of evaluating only the final harvest.</p></div></section>

    <section class="mt-16"><SectionHeading eyebrow="What players are testing" title="Greedy Growers fast-money creator test" description="The video title confirms player demand for fast-money tactics, but its individual run remains creator experience rather than an official formula."/><div class="mt-8 max-w-4xl"><PlayerTestCard videoId="mExYrQLjcvg" title="Greedy Growers Guide! (Codes, Tips & Tricks, GET MONEY FAST) ROBLOX" author="ItzVexo" test="A creator walkthrough that combines early-game tips, codes interest, and faster money decisions." conclusion="The creator presents a practical route for accelerating income during a recorded play session." reproducibility="Repeat the seed cost, wait time, harvest result, and failed-run count in your own server before accepting the claimed pace." status="creator-experience"/></div></section>

    <nav class="mt-14 flex flex-wrap gap-3"><a href="/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Open the Calculator</a><a href="/guides/progression/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Plan the next unlock</a><a href="/mechanics/when-to-harvest/" class="rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Choose when to harvest</a></nav>
  </section>
</BaseLayout>
