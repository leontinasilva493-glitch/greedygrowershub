---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../../lib/seo';

const metadata = pageSeo.guides;
const guides = [
  { title: 'Beginner Guide — Your First Harvest', href: '/beginner-guide/', label: 'First session', linkLabel: 'Follow the first-harvest beginner guide', description: 'Join the correct Roblox game, buy one seed, plant it, and complete a first harvest.' },
  { title: 'Get Money Fast — Safer Farming Strategies', href: '/guides/get-money-fast/', label: 'Immediate profit', linkLabel: 'Learn safer ways to get money fast', description: 'Protect starting coins, avoid slow decisions, and recover after a lightning loss.' },
  { title: 'Progression Guide — Leveling and Rebirth', href: '/guides/progression/', label: 'Unlock order', linkLabel: 'Plan leveling and rebirth progression', description: 'Plan early, mid, and late game priorities across tickets, fertilizer, rebirth, and the market.' },
  { title: 'Tickets Guide — Current Evidence and Open Questions', href: '/guides/tickets/', label: 'Needs verification', linkLabel: 'Review current Tickets evidence', description: 'Separate reported ticket sources and uses from limits that still require an in-game check.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: metadata.h1, description: metadata.description, url: absoluteUrl(metadata.canonicalPath) },
  buildBreadcrumbSchema([{ name: 'Greedy Growers Calculator', path: '/' }, { name: 'Guides', path: metadata.canonicalPath }]),
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schema}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-4xl"><p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Solve the next player problem</p><h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1><p class="mt-5 text-lg leading-8 text-sand-300">Start with the guide that matches your current decision instead of reading one long, mixed wiki page.</p></div>

    <section class="mt-16" aria-label="Greedy Growers guide map"><p class="font-mono text-xs uppercase tracking-[.16em] text-leaf-400">Guide map</p><p class="mt-3 max-w-3xl text-sm leading-6 text-sand-300">Each page owns one search intent and links to Mechanics when the question becomes about lightning or harvest timing.</p><div class="mt-8 grid gap-5 sm:grid-cols-2">{guides.map((guide) => <a href={guide.href} class="rounded-2xl border border-line bg-ink-900 p-6 no-underline transition hover:-translate-y-1 hover:border-leaf-500/50"><p class="font-mono text-xs uppercase tracking-[.16em] text-leaf-400">{guide.label}</p><h2 class="mt-3 font-display text-2xl font-bold text-white">{guide.title}</h2><p class="mt-3 text-sm leading-6 text-sand-300">{guide.description}</p><span class="mt-5 inline-flex text-sm font-bold text-leaf-400">{guide.linkLabel} →</span></a>)}</div></section>

    <aside class="mt-16 rounded-2xl border border-line bg-ink-900 p-6"><p class="font-display text-xl font-bold text-white">Money guide versus progression guide</p><p class="mt-3 text-sm leading-6 text-sand-300">Use Get Money Fast for the question “How do I earn more right now?” Use Progression for “What should I unlock next?” Keeping the jobs separate prevents the two pages from competing for the same search intent.</p></aside>

    <aside class="mt-8 rounded-2xl border border-amber-400/25 bg-amber-300/[.06] p-6"><p class="font-display text-xl font-bold text-amber-100">How Greedy Growers guide claims are marked</p><p class="mt-3 text-sm leading-6 text-sand-300">Game details change quickly. Read the visible Official, In-game verified, Community-reported, Creator experience, or Not verified label before treating a claim as a rule.</p></aside>
  </section>
</BaseLayout>
