---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../../lib/seo';

const metadata = pageSeo.guides;
const guides = [
  { title: 'Beginner Guide', href: '/beginner-guide/', label: 'First session', description: 'Join the correct Roblox game, buy one seed, plant it, and complete a first harvest.' },
  { title: 'Get Money Fast', href: '/guides/get-money-fast/', label: 'Immediate profit', description: 'Protect starting coins, avoid slow decisions, and recover after a lightning loss.' },
  { title: 'Progression Guide', href: '/guides/progression/', label: 'Unlock order', description: 'Plan early, mid, and late game priorities across tickets, fertilizer, rebirth, and the market.' },
  { title: 'Tickets Guide', href: '/guides/tickets/', label: 'Needs verification', description: 'Separate reported ticket sources and uses from limits that still require an in-game check.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: metadata.h1, description: metadata.description, url: absoluteUrl(metadata.canonicalPath) },
  buildBreadcrumbSchema([{ name: 'Greedy Growers Calculator', path: '/' }, { name: 'Guides', path: metadata.canonicalPath }]),
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schema}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-4xl"><p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Solve the next player problem</p><h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1><p class="mt-5 text-lg leading-8 text-sand-300">Start with the guide that matches your current decision instead of reading one long, mixed wiki page.</p></div>

    <section class="mt-16"><SectionHeading eyebrow="Guide map" title="Choose a Greedy Growers guide" description="Each page owns one search intent and links to Mechanics when the question becomes about lightning or harvest timing."/><div class="mt-8 grid gap-5 sm:grid-cols-2">{guides.map((guide) => <a href={guide.href} class="rounded-2xl border border-line bg-ink-900 p-6 no-underline transition hover:-translate-y-1 hover:border-leaf-500/50"><p class="font-mono text-xs uppercase tracking-[.16em] text-leaf-400">{guide.label}</p><h3 class="mt-3 font-display text-2xl font-bold text-white">{guide.title}</h3><p class="mt-3 text-sm leading-6 text-sand-300">{guide.description}</p><span class="mt-5 inline-flex text-sm font-bold text-leaf-400">Open guide →</span></a>)}</div></section>

    <section class="mt-16"><SectionHeading eyebrow="Different jobs" title="Money guide versus progression guide" description="The two pages answer different moments, so their keywords and recommendations do not compete."/><div class="mt-8 grid gap-5 md:grid-cols-2"><article class="rounded-2xl border border-line bg-ink-900 p-6"><h3 class="font-display text-xl font-bold text-white">How do I earn more right now?</h3><p class="mt-3 text-sm leading-6 text-sand-300">Use Get Money Fast for capital protection, failed-run recovery, and deciding whether another seed or fertilizer purchase is affordable.</p></article><article class="rounded-2xl border border-line bg-ink-900 p-6"><h3 class="font-display text-xl font-bold text-white">What should I unlock next?</h3><p class="mt-3 text-sm leading-6 text-sand-300">Use Progression for early, mid, and late game priorities, including reported rebirth requirements and fertilizer unlocks.</p></article></div></section>

    <section class="mt-16"><SectionHeading eyebrow="Evidence labels" title="How Greedy Growers guide claims are marked" description="Game details change quickly, so a claim needs a visible strength instead of confident wording alone."/><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">{['Official','In-game verified','Community-reported','Creator experience','Not verified'].map((label) => <article class="rounded-xl border border-line bg-ink-900 p-4"><h3 class="font-semibold text-white">{label}</h3><p class="mt-2 text-xs leading-5 text-sand-300">Read the label before treating the claim as a rule for your next run.</p></article>)}</div></section>
  </section>
</BaseLayout>
