---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { fertilizers, getSource, rebirths, site } from '../../lib/content';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../../lib/seo';

const metadata = pageSeo.progression;
const source = getSource('greedygrowers-codes');
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: metadata.h1, description: metadata.description, dateModified: site.checkedAt, mainEntityOfPage: absoluteUrl(metadata.canonicalPath) },
  buildBreadcrumbSchema([{ name: 'Greedy Growers Calculator', path: '/' }, { name: 'Guides', path: '/guides/' }, { name: 'Progression', path: metadata.canonicalPath }]),
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schema}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-4xl"><p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">One pillar before many thin pages</p><h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1><p class="mt-5 text-lg leading-8 text-sand-300">Use one progression route for early, mid, and late game priorities while Tickets, fertilizer, rebirth, and Farmer's Market details are still being rechecked.</p><div class="mt-6 flex flex-wrap items-center gap-3"><StatusBadge state="community-lead" label="Community snapshot"/><span class="text-sm text-sand-300">Reported data checked {site.checkedAt}; not official.</span></div></div>

    <section class="mt-16"><SectionHeading eyebrow="Early game" title="Build a repeatable first-hour economy" description="The early goal is not maximum tree height. It is enough capital and timing experience to survive a failed run."/><div class="mt-8 grid gap-4 md:grid-cols-3"><article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Complete clean cycles</h3><p class="mt-2 text-sm text-sand-300">Buy, plant, harvest, sell, and repeat without exhausting the seed reserve.</p></article><article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Record failure cost</h3><p class="mt-2 text-sm text-sand-300">A destroyed tree still belongs in the sequence cost.</p></article><article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Investigate Tickets</h3><p class="mt-2 text-sm text-sand-300">Use the <a class="text-leaf-400" href="/guides/tickets/">Tickets Guide</a> before assuming a daily or event source.</p></article></div></section>

    <section class="mt-16"><SectionHeading eyebrow="Mid game" title="Test Greedy Growers fertilizer and market unlocks" description="The copied snapshot reports three fertilizer tiers, but cost and multiplier values still need an in-game recheck."/><div class="mt-8 overflow-x-auto rounded-2xl border border-line"><table class="w-full text-left text-sm"><thead class="bg-ink-900 font-mono text-xs uppercase tracking-[.12em] text-sand-300"><tr><th class="px-5 py-4">Fertilizer</th><th class="px-5 py-4">Reported cost</th><th class="px-5 py-4">Reported multiplier</th><th class="px-5 py-4">Status</th></tr></thead><tbody>{fertilizers.map((item) => <tr class="border-t border-line bg-ink-950/40"><td class="px-5 py-4 font-bold">{item.name}</td><td class="px-5 py-4">{item.cost.toLocaleString()}</td><td class="px-5 py-4">x{item.boostMultiplier}</td><td class="px-5 py-4"><StatusBadge state={item.verification}/></td></tr>)}</tbody></table></div><p class="mt-5 text-sm text-sand-300">Farmer's Market access is reported as a Level 1 rebirth perk. Confirm the location and current UI in game before planning a purchase route.</p></section>

    <section class="mt-16"><SectionHeading eyebrow="Late game" title="Greedy Growers rebirth requirements and perks" description="Rebirth may reset progress in exchange for permanent perks. Treat every requirement below as a community lead until reproduced."/><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{rebirths.map((rebirth) => <article class="rounded-2xl border border-line bg-ink-900 p-5"><div class="flex items-center justify-between"><h3 class="font-display text-xl font-bold text-white">Rebirth {rebirth.level}</h3><StatusBadge state={rebirth.verification}/></div><p class="mt-3 text-sm text-leaf-400">{rebirth.requirement}</p><ul class="mt-4 grid gap-2 text-sm text-sand-300">{rebirth.perks.map((perk) => <li>• {perk}</li>)}</ul></article>)}</div></section>

    <section class="mt-16"><SectionHeading eyebrow="Split-page gate" title="When progression topics deserve separate guides" description="Fertilizer, Rebirth, and Farmer's Market stay here until each can answer an independent search problem with reliable evidence."/><div class="mt-8 grid gap-4 md:grid-cols-3">{['Enough verified game data','A distinct player decision','Original screenshots or a reproducible route'].map((item) => <article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">{item}</h3><p class="mt-2 text-sm text-sand-300">Without this condition, a separate page would only repeat this pillar and create thin content.</p></article>)}</div></section>

    <p class="mt-10 text-xs text-sand-300">Snapshot source: <a class="underline" href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a>.</p>
    <nav class="mt-8 flex flex-wrap gap-3"><a href="/guides/get-money-fast/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Make money safely first</a><a href="/seeds/best-seeds/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Compare seeds by stage</a><a href="/mechanics/when-to-harvest/" class="rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Plan harvest timing</a></nav>
  </section>
</BaseLayout>
