---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlayerTestCard from '../../components/PlayerTestCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../../lib/seo';

const metadata = pageSeo.tickets;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: metadata.h1, description: metadata.description, mainEntityOfPage: absoluteUrl(metadata.canonicalPath) },
  buildBreadcrumbSchema([{ name: 'Greedy Growers Calculator', path: '/' }, { name: 'Guides', path: '/guides/' }, { name: 'Tickets', path: metadata.canonicalPath }]),
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schema}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-4xl"><p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Demand confirmed, mechanism pending</p><h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1><p class="mt-5 text-lg leading-8 text-sand-300">Players are actively searching for Tickets, but the exact source, use location, and limits need a current in-game check before we publish a step-by-step farming route.</p></div>

    <section class="mt-16"><SectionHeading eyebrow="Current status" title="What is known about Greedy Growers Tickets" description="Creator videos show clear interest in getting Tickets, but that is not the same as an official source or stable limit."/><div class="mt-8 grid gap-4 md:grid-cols-3"><article class="rounded-2xl border border-line bg-ink-900 p-5"><StatusBadge state="reported" label="Community-reported"/><h3 class="mt-4 font-bold text-white">Tickets exist in player discussion</h3><p class="mt-2 text-sm text-sand-300">The topic appears directly in a current Greedy Growers guide title.</p></article><article class="rounded-2xl border border-line bg-ink-900 p-5"><StatusBadge state="needs-check" label="Not verified"/><h3 class="mt-4 font-bold text-white">Exact acquisition source</h3><p class="mt-2 text-sm text-sand-300">Daily, event, one-time, and gameplay sources still need separation.</p></article><article class="rounded-2xl border border-line bg-ink-900 p-5"><StatusBadge state="needs-check" label="Not verified"/><h3 class="mt-4 font-bold text-white">Use location and limits</h3><p class="mt-2 text-sm text-sand-300">The spend UI, cap, reset time, and update behavior still require proof.</p></article></div></section>

    <section class="mt-16"><SectionHeading eyebrow="Verification route" title="How to verify a Greedy Growers Ticket claim" description="Capture enough context that another player can reproduce the result after an update."/><ol class="mt-8 grid gap-4 sm:grid-cols-2"><li class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">1. Record the source screen</h3><p class="mt-2 text-sm text-sand-300">Show the NPC, menu, reward screen, event, or task that grants the Ticket.</p></li><li class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">2. Record balance before and after</h3><p class="mt-2 text-sm text-sand-300">A visible balance change is stronger than a voice-over claim.</p></li><li class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">3. Test repeat limits</h3><p class="mt-2 text-sm text-sand-300">Repeat once, change server if safe, and note whether a timer or cap appears.</p></li><li class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">4. Save the game update date</h3><p class="mt-2 text-sm text-sand-300">A later patch can invalidate a correct older route.</p></li></ol></section>

    <section class="mt-16"><SectionHeading eyebrow="What players are testing" title="Greedy Growers Get Tickets creator test" description="Use the video to identify a route worth checking, not as automatic proof of a permanent mechanic."/><div class="mt-8 max-w-4xl"><PlayerTestCard videoId="_AVEX4jTHHQ" title="Greedy Growers Guide! (Tips & Tricks, Big Plants, Get Tickets) ROBLOX" author="Vorzy Brookhaven" test="A creator guide that includes big plants, general tips, and a route described as getting Tickets." conclusion="The creator presents Tickets as an actionable part of a recorded game session." reproducibility="Confirm the exact grant screen, balance change, repeatability, and current update date in your own session." status="creator-experience"/></div></section>

    <section class="mt-16"><SectionHeading eyebrow="Next update" title="What this Tickets guide will add after verification" description="The page will become a full route only when the source and limit can be reproduced."/><div class="mt-8 rounded-2xl border border-line bg-ink-900 p-6"><h3 class="font-bold text-white">Required evidence</h3><p class="mt-3 text-sm leading-6 text-sand-300">Accurate source, use location, daily/event/one-time limit, reset timing, and whether an update changed the mechanism.</p></div></section>

    <nav class="mt-14 flex flex-wrap gap-3"><a href="/updates/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Check update status</a><a href="/guides/progression/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Return to Progression</a><a href="/contact/" class="rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Prepare a correction</a></nav>
  </section>
</BaseLayout>
