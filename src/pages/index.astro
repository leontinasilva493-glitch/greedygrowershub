---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import CalculatorSeedPreview from '../components/CalculatorSeedPreview.astro';
import EditorialVisual from '../components/EditorialVisual.astro';
import EvidenceBar from '../components/EvidenceBar.astro';
import CurrentTasks from '../components/CurrentTasks.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { evidenceByPage } from '../data/evidence';
import { site } from '../lib/content';
import { absoluteUrl, pageSeo } from '../lib/seo';

const metadata = pageSeo.home;
const faqs = [
  ['Are the seed references and fertilizer presets official?', 'No. Current seed names come from two matching guide reports, while fertilizer presets remain a legacy community snapshot. Enter the economics observed in your own run.'],
  ['Does this calculator predict lightning?', 'No. It records failed runs that already happened and shows their cost. It does not know hidden odds or predict the next strike.'],
  ['How is profit per minute calculated?', 'The calculator subtracts seed and fertilizer cost from the boosted harvest value, then divides one successful run by the entered wait time.'],
  ['Why can risk-adjusted profit be negative?', 'Every failed run adds another seed and fertilizer investment. A later harvest can be profitable by itself but still fail to recover the earlier losses.'],
];
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: metadata.h1,
    description: metadata.description,
    url: absoluteUrl('/'),
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isPartOf: { '@type': 'WebSite', name: site.name, url: absoluteUrl('/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schemas} socialImage={metadata.image}>
  <section data-page-hero class="border-b border-line bg-[linear-gradient(120deg,#071510_0%,#0a2117_54%,#08130f_100%)]">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 sm:py-16 min-[800px]:grid-cols-[minmax(0,1.05fr)_minmax(22rem,.95fr)] min-[800px]:items-center min-[800px]:gap-10 lg:px-8">
      <div class="min-w-0">
        <div class="inline-flex items-center gap-2 rounded-full border border-leaf-500/25 bg-leaf-500/[.07] px-3 py-1.5 font-mono text-[10px] font-bold uppercase tracking-[.16em] text-leaf-400"><Icon name="calculator" size={13}/> Free player-run calculator</div>
        <h1 class="title-home mt-6 font-display font-bold tracking-[-.055em] text-white">{metadata.h1}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-sand-300">Calculate profit per minute, recover failed-run costs, and test your observed seed inputs before risking another tree to lightning.</p>
        <div class="mt-7 flex flex-wrap gap-3 text-sm">
          <a href="#calculator" class="rounded-md bg-leaf-500 px-5 py-3 font-bold text-ink-950 no-underline">Start calculating</a>
          <a href="/mechanics/when-to-harvest/" class="rounded-md border border-line bg-ink-900 px-5 py-3 font-bold text-white no-underline">Plan when to harvest</a>
          <a href={site.officialGameUrl} target="_blank" rel="noopener noreferrer" data-event="play_roblox_click" class="inline-flex items-center gap-2 rounded-md border border-line px-5 py-3 font-bold text-white no-underline">Play on Roblox <Icon name="external" size={15}/></a>
        </div>
      </div>
      <EditorialVisual
        slug="greedy-growers-profit-calculator-farming-loop"
        alt={metadata.image.alt}
        loading="eager"
        widthPreset="hero"
        className="min-[800px]:row-span-2"
      />
      <div class="min-[800px]:col-start-1"><EvidenceBar {...evidenceByPage.home} tone="subtle" /></div>
    </div>
  </section>

  <CurrentTasks />

  <section id="calculator" class="mx-auto max-w-7xl scroll-mt-24 px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <Calculator />
  </section>

  <section class="border-b border-line bg-ink-950" aria-labelledby="home-task-path-title">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
        <div>
          <p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-leaf-400">Fan-made player reference</p>
          <h2 id="home-task-path-title" class="mt-2 font-display text-2xl font-bold tracking-[-.035em] text-white sm:text-3xl">Greedy Growers Wiki: Seeds, Mutations, Codes & Calculator</h2>
        </div>
        <p class="max-w-xl text-sm leading-6 text-sand-300">This fan-made Greedy Growers wiki organizes the current Update 1.2 seed and mutation reports, code status, beginner guides, updates, and a player-input profit calculator. Community figures remain evidence-labeled and are not treated as official developer data.</p>
      </div>

      <nav class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" aria-label="Greedy Growers wiki directory">
        <a href="/seeds/list/" data-event="home_task_click" data-event-label="all-seeds" class="group flex min-h-24 items-center gap-4 rounded-2xl border border-line bg-ink-900 p-4 no-underline transition hover:border-leaf-500/50 hover:bg-ink-850 sm:min-h-32 sm:flex-col sm:items-stretch sm:justify-between sm:gap-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-leaf-500/25 bg-leaf-500/[.08] text-leaf-400"><Icon name="sprout" size={20}/></span>
          <span><strong class="block font-display text-base text-white group-hover:text-leaf-300">All Seeds</strong><span class="mt-1 block text-sm leading-5 text-sand-300">Search, filter, and compare all 20 reported seeds.</span></span>
        </a>
        <a href="/mechanics/mutations/" data-event="home_task_click" data-event-label="mutations" class="group flex min-h-24 items-center gap-4 rounded-2xl border border-line bg-ink-900 p-4 no-underline transition hover:border-leaf-500/50 hover:bg-ink-850 sm:min-h-32 sm:flex-col sm:items-stretch sm:justify-between sm:gap-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-leaf-500/25 bg-leaf-500/[.08] text-leaf-400"><Icon name="bolt" size={20}/></span>
          <span><strong class="block font-display text-base text-white group-hover:text-leaf-300">All Mutations</strong><span class="mt-1 block text-sm leading-5 text-sand-300">Check six reported mutations, triggers, and evidence limits.</span></span>
        </a>
        <a href="/codes/" data-event="home_task_click" data-event-label="codes" class="group flex min-h-24 items-center gap-4 rounded-2xl border border-line bg-ink-900 p-4 no-underline transition hover:border-leaf-500/50 hover:bg-ink-850 sm:min-h-32 sm:flex-col sm:items-stretch sm:justify-between sm:gap-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-leaf-500/25 bg-leaf-500/[.08] text-leaf-400"><Icon name="ticket" size={20}/></span>
          <span><strong class="block font-display text-base text-white group-hover:text-leaf-300">Codes</strong><span class="mt-1 block text-sm leading-5 text-sand-300">See the latest verified code status and redemption checks.</span></span>
        </a>
        <a href="/beginner-guide/" data-event="home_task_click" data-event-label="beginner-guide" class="group flex min-h-24 items-center gap-4 rounded-2xl border border-line bg-ink-900 p-4 no-underline transition hover:border-leaf-500/50 hover:bg-ink-850 sm:min-h-32 sm:flex-col sm:items-stretch sm:justify-between sm:gap-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-leaf-500/25 bg-leaf-500/[.08] text-leaf-400"><Icon name="book" size={20}/></span>
          <span><strong class="block font-display text-base text-white group-hover:text-leaf-300">Beginner Guide</strong><span class="mt-1 block text-sm leading-5 text-sand-300">Follow the first seed, planting, harvest, and selling loop.</span></span>
        </a>
        <a href="/updates/" data-event="home_task_click" data-event-label="updates" class="group flex min-h-24 items-center gap-4 rounded-2xl border border-line bg-ink-900 p-4 no-underline transition hover:border-leaf-500/50 hover:bg-ink-850 sm:min-h-32 sm:flex-col sm:items-stretch sm:justify-between sm:gap-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-leaf-500/25 bg-leaf-500/[.08] text-leaf-400"><Icon name="clock" size={20}/></span>
          <span><strong class="block font-display text-base text-white group-hover:text-leaf-300">Updates</strong><span class="mt-1 block text-sm leading-5 text-sand-300">Review game signals, data changes, and recheck work.</span></span>
        </a>
        <a href="#calculator" data-event="home_task_click" data-event-label="calculator" class="group flex min-h-24 items-center gap-4 rounded-2xl border border-leaf-500/35 bg-leaf-500/[.065] p-4 no-underline transition hover:border-leaf-400 hover:bg-leaf-500/[.1] sm:min-h-32 sm:flex-col sm:items-stretch sm:justify-between sm:gap-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-leaf-500 text-ink-950"><Icon name="calculator" size={20}/></span>
          <span><strong class="block font-display text-base text-white group-hover:text-leaf-300">Profit Calculator</strong><span class="mt-1 block text-sm leading-5 text-sand-300">Use your observed costs, harvest, time, and failed runs.</span></span>
        </a>
      </nav>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8" aria-label="Reported seed catalog preview">
    <CalculatorSeedPreview />
  </section>

  <section class="border-b border-line bg-ink-900/45" aria-labelledby="update-12-answer">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_1.15fr] lg:px-8">
      <div>
        <p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-leaf-400">Update 1.2 · direct answer</p>
        <h2 id="update-12-answer" class="mt-3 font-display text-3xl font-bold tracking-[-.035em] text-white sm:text-4xl">What Changed in Greedy Growers Update 1.2?</h2>
        <p class="mt-4 max-w-2xl leading-7 text-sand-300">The current public evidence supports a larger seed catalog and a six-mutation system. Two independent guides match on the names and reported values; neither is a developer source, so use these as current research leads and verify expensive choices in your server.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/seeds/list/" class="group rounded-2xl border border-line bg-ink-950/60 p-6 no-underline hover:border-leaf-500/50">
          <p class="font-mono text-3xl font-bold text-leaf-400">20</p>
          <h3 class="mt-3 font-display text-xl font-bold text-white">20 reported seeds</h3>
          <p class="mt-2 text-sm leading-6 text-sand-300">Current prices, rarity labels, and reported river spawn denominators.</p>
          <span class="mt-4 inline-flex text-sm font-bold text-leaf-400">Open Seed List →</span>
        </a>
        <a href="/mechanics/mutations/" class="group rounded-2xl border border-line bg-ink-950/60 p-6 no-underline hover:border-leaf-500/50">
          <p class="font-mono text-3xl font-bold text-leaf-400">6</p>
          <h3 class="mt-3 font-display text-xl font-bold text-white">6 reported mutations</h3>
          <p class="mt-2 text-sm leading-6 text-sand-300">Weather or lightning triggers with reported 2x–100x values.</p>
          <span class="mt-4 inline-flex text-sm font-bold text-leaf-400">Open Mutation Map →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-ink-900/45">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Clean inputs" title="How to Record Clean Run Data" description="One repeatable run is more useful than a confident-looking preset. Keep the inputs consistent and recheck them whenever the game changes." />
      <div class="mt-9 grid gap-4 md:grid-cols-2">
        <article class="rounded-2xl border border-line bg-ink-950/60 p-6"><h3 class="font-display text-xl font-bold text-white">Pick One Seed and Keep the Wait Consistent</h3><p class="mt-3 text-sm leading-6 text-sand-300">Write down the seed cost, choose one harvest target, and repeat comparable attempts. Changing the seed and wait together makes the result harder to interpret.</p></article>
        <article class="rounded-2xl border border-line bg-ink-950/60 p-6"><h3 class="font-display text-xl font-bold text-white">Recalculate After Every Game Update</h3><p class="mt-3 text-sm leading-6 text-sand-300">Retest copied values after a patch and count every lightning failure. A destroyed run still consumed its seed and fertilizer.</p></article>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <SectionHeading eyebrow="Transparent math" title="How the Math Works (Quick Summary)" description="The tool uses only visible inputs and simple arithmetic. It does not add hidden lightning odds or claim access to Roblox account data." />
    <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-semibold text-white">Cost per attempt</h3><code class="mt-3 block text-sm text-leaf-400">seed + fertilizer</code></article>
      <article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-semibold text-white">Boosted harvest</h3><code class="mt-3 block text-sm text-leaf-400">harvest × multiplier</code></article>
      <article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-semibold text-white">Profit per success</h3><code class="mt-3 block text-sm text-leaf-400">boosted value − cost</code></article>
      <article class="rounded-2xl border border-line bg-ink-900 p-5"><h3 class="font-semibold text-white">Failed-run break-even</h3><code class="mt-3 block text-sm text-leaf-400">cost × total attempts</code></article>
    </div>
    <nav class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Continue from the Calculator">
      <a href="/seeds/list/" data-event="calculator_continue_click" data-event-label="seed-list" class="rounded-2xl border border-line bg-ink-900 p-5 no-underline hover:border-leaf-500/50"><span class="font-bold text-white">Compare all reported seeds</span><span class="mt-2 block text-sm text-sand-300">Filter price, rarity, spawn chance, and evidence →</span></a>
      <a href="/mechanics/when-to-harvest/" data-event="calculator_continue_click" data-event-label="harvest-timing" class="rounded-2xl border border-line bg-ink-900 p-5 no-underline hover:border-leaf-500/50"><span class="font-bold text-white">Plan when to harvest</span><span class="mt-2 block text-sm text-sand-300">Compare capital-first and risky timing →</span></a>
      <a href="/guides/get-money-fast/" data-event="calculator_continue_click" data-event-label="money-guide" class="rounded-2xl border border-line bg-ink-900 p-5 no-underline hover:border-leaf-500/50"><span class="font-bold text-white">Protect the next planting</span><span class="mt-2 block text-sm text-sand-300">Build a safer spending and recovery route →</span></a>
      <a href="/updates/" data-event="calculator_continue_click" data-event-label="updates" class="rounded-2xl border border-line bg-ink-900 p-5 no-underline hover:border-leaf-500/50"><span class="font-bold text-white">Check data freshness</span><span class="mt-2 block text-sm text-sand-300">See which presets still need a recheck →</span></a>
    </nav>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <SectionHeading eyebrow="Quick answers" title="Frequently Asked Questions" />
    <div class="mt-8 grid gap-3">
      {faqs.map(([question, answer]) => <details class="group rounded-xl border border-line bg-ink-900 p-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-display font-bold text-white">{question}<span class="text-leaf-400 transition group-open:rotate-45">+</span></summary><p class="mt-4 max-w-3xl text-sm leading-6 text-sand-300">{answer}</p></details>)}
    </div>
  </section>
</BaseLayout>
