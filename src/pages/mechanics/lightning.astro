---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlayerTestCard from '../../components/PlayerTestCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../../lib/seo';

const metadata = pageSeo.lightning;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: metadata.h1, description: metadata.description, mainEntityOfPage: absoluteUrl(metadata.canonicalPath) },
  buildBreadcrumbSchema([{ name: 'Greedy Growers Calculator', path: '/' }, { name: 'Mechanics', path: '/mechanics/' }, { name: 'Lightning', path: metadata.canonicalPath }]),
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schema}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-4xl"><p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Facts before timing advice</p><h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1><p class="mt-5 text-lg leading-8 text-sand-300">The official game loop warns players to harvest before lightning. Exact strike odds, timers, height thresholds, and seed-specific behavior still require evidence.</p></div>

    <aside class="mt-10 grid gap-4 md:grid-cols-3" aria-label="Lightning evidence summary"><article class="rounded-2xl border border-leaf-500/25 bg-leaf-500/[.045] p-5"><p class="font-mono text-xs uppercase tracking-[.14em] text-leaf-400">Confirmed</p><h3 class="mt-2 font-bold text-white">Lightning belongs to the official game loop</h3><p class="mt-2 text-sm leading-6 text-sand-300">The official listing tells players to harvest before lightning strikes.</p></article><article class="rounded-2xl border border-amber-400/25 bg-amber-300/[.06] p-5"><p class="font-mono text-xs uppercase tracking-[.14em] text-amber-200">Not Verified</p><h3 class="mt-2 font-bold text-white">Odds, timers, and height thresholds</h3><p class="mt-2 text-sm leading-6 text-sand-300">No reproducible public source supports a universal percentage or safe height.</p></article><article class="rounded-2xl border border-line bg-ink-900 p-5"><p class="font-mono text-xs uppercase tracking-[.14em] text-sand-300">Practical decision</p><h3 class="mt-2 font-bold text-white">Use Exposure Time, Not Invented Odds</h3><p class="mt-2 text-sm leading-6 text-sand-300">A longer wait means the run remains at risk longer; it does not prove a numeric strike curve.</p></article></aside>

    <section class="mt-16"><SectionHeading eyebrow="Confirmed boundary" title="How Lightning Works — Confirmed Facts" description="Keep the confirmed risk separate from attractive but unsupported precision."/><div class="mt-8 grid gap-4 md:grid-cols-2"><article class="rounded-2xl border border-line bg-ink-900 p-6"><StatusBadge state="official"/><h3 class="mt-4 font-display text-xl font-bold text-white">Lightning is part of the harvest risk loop</h3><p class="mt-3 text-sm leading-6 text-sand-300">The official listing describes growing a tree and harvesting before lightning strikes. That supports the existence of the risk, not a numeric probability.</p></article><article class="rounded-2xl border border-line bg-ink-900 p-6"><StatusBadge state="needs-check"/><h3 class="mt-4 font-display text-xl font-bold text-white">Exact loss consequences need a current capture</h3><p class="mt-3 text-sm leading-6 text-sand-300">Record whether the tree, seed, fertilizer, multiplier, or another resource is lost in the current version instead of assuming every update behaves the same.</p></article></div></section>

    <section class="mt-16"><SectionHeading eyebrow="Signal check" title="Warning Signs — What Is and Is Not Verified" description="A useful warning must be visible, repeatable, and tested across more than one run."/><div class="mt-8 grid gap-4 md:grid-cols-3"><article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Visual weather cue</h3><p class="mt-2 text-sm text-sand-300">Not verified as a reliable timer. Capture the cue and time to strike across repeated runs.</p></article><article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Tree height threshold</h3><p class="mt-2 text-sm text-sand-300">Not verified. Taller trees may increase exposure time without proving height controls the strike.</p></article><article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Seed-specific risk</h3><p class="mt-2 text-sm text-sand-300">Not verified. Compare the same wait target across seeds before claiming different odds.</p></article></div></section>

    <section class="mt-16"><SectionHeading eyebrow="What players are testing" title="Maximum-Tree Lightning Exposure Tests" description="A large-tree challenge is useful evidence of player behavior, but one creator run cannot establish a universal strike formula."/><div class="mt-8 max-w-4xl"><PlayerTestCard videoId="OjyHrsBTE6I" title="Growing the Tallest Tree in Roblox Greedy Growers" author="OTTER ON ROBLOX" test="A maximum-greed attempt that leaves a tree exposed while pursuing an unusually tall result." conclusion="The creator treats height and continued waiting as the core challenge." reproducibility="Record elapsed time, tree state, any warning cue, and the exact consequence if lightning strikes. Repeat before claiming a threshold." status="creator-experience"/></div></section>

    <section class="mt-16"><SectionHeading eyebrow="Research checklist" title="How to Test a Lightning Timing Claim" description="Use repeated observations so a coincidence does not become a fake rule."/><ol class="mt-8 grid gap-4 sm:grid-cols-2"><li class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Keep seed and wait target fixed</h3><p class="mt-2 text-sm text-sand-300">Change one variable at a time.</p></li><li class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Count successful and failed runs</h3><p class="mt-2 text-sm text-sand-300">Do not report only dramatic failures.</p></li><li class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Capture warning signals</h3><p class="mt-2 text-sm text-sand-300">Save video from before the cue through the outcome.</p></li><li class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Record the update date</h3><p class="mt-2 text-sm text-sand-300">Retest when the Roblox listing changes.</p></li></ol></section>

    <nav class="mt-14 flex flex-wrap gap-3"><a href="/mechanics/when-to-harvest/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Choose when to harvest</a><a href="/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Calculate failed-run cost</a><a href="/updates/" class="rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Check update status</a></nav>
  </section>
</BaseLayout>
