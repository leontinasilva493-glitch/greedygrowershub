---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { seeds, site, sources } from '../../lib/content';
import { sortSeeds } from '../../lib/seeds';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../../lib/seo';

const metadata = pageSeo.bestSeeds;
const budgetSeeds = sortSeeds(seeds, 'costSortValue', 'asc').slice(0, 5);
const rarestSeeds = sortSeeds(seeds, 'spawnOneIn', 'desc').slice(0, 4);
const goalTiers = [
  { goal: 'Learn the loop', tier: 'Oak / Pine', evidence: 'Lowest reported buy-in', next: 'Record one clean harvest' },
  { goal: 'Protect capital', tier: 'Budget-dependent', evidence: 'Price versus two-failure reserve', next: 'Use the same seed and wait target' },
  { goal: 'Watch rare stock', tier: 'Diamond / Void', evidence: 'Largest reported spawn denominator', next: 'Verify the live river listing' },
];
const sourceItems = sources.filter((source) => ['pro-game-guides', 'mrguider'].includes(source.id));
const schemas = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: metadata.h1, description: metadata.description, url: absoluteUrl(metadata.canonicalPath), dateModified: site.checkedAt },
  buildBreadcrumbSchema([{ name: 'Greedy Growers Hub', path: '/' }, { name: 'Seeds', path: '/seeds/list/' }, { name: 'Best Seeds', path: metadata.canonicalPath }]),
];
const spawn = (value: number | null) => value === null ? 'Not reported' : `1 in ${value.toLocaleString('en-US')}`;
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schemas}>
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <header class="max-w-4xl">
      <div class="flex flex-wrap items-center gap-3"><p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Best depends on your goal</p><StatusBadge state="community-lead" label="No profit ranking yet" /></div>
      <h1 class="title-page mt-5 font-bold tracking-[-.04em]">{metadata.h1}</h1>
      <p class="mt-6 text-lg leading-8 text-sand-300">The current 20-seed catalog tells us reported price, rarity, and shop spawn chance. It does not yet establish current harvest value, growth time, mutation payout, or failed-run rate—so this guide ranks only the decisions the evidence can support.</p>
    </header>

    <section class="mt-12 rounded-3xl border border-line bg-ink-900 p-6 sm:p-8">
      <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Best Seeds by Player Goal</p>
      <h2 class="mt-3 text-2xl font-bold">Seed Tier List by Verified Dimension</h2>
      <p class="mt-4 max-w-3xl leading-7 text-sand-300">This is a decision tier list — Not a profit tier. Each row uses only a dimension the current reports provide: buy-in, reserve fit, or shop rarity. Harvest value and growth time remain player-observed inputs.</p>
      <div class="mt-7 hidden overflow-x-auto rounded-2xl border border-line md:block">
        <table class="w-full min-w-[680px] text-left text-sm">
          <thead class="bg-ink-950/55 font-mono text-xs uppercase tracking-[.12em] text-sand-300"><tr><th class="px-5 py-4">Player goal</th><th class="px-5 py-4">Current tier</th><th class="px-5 py-4">Evidence used</th><th class="px-5 py-4">Next check</th></tr></thead>
          <tbody>{goalTiers.map((item) => <tr class="border-t border-line"><td class="px-5 py-4 font-bold text-white">{item.goal}</td><td class="px-5 py-4 text-leaf-400">{item.tier}</td><td class="px-5 py-4 text-sand-300">{item.evidence}</td><td class="px-5 py-4 text-sand-300">{item.next}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="mt-6 grid gap-3 md:hidden" data-mobile-goal-tiers>
        {goalTiers.map((item) => <article class="rounded-2xl border border-line bg-ink-950/55 p-4"><p class="text-sm font-bold text-white">{item.goal}</p><p class="mt-2 font-mono text-lg font-bold text-leaf-400">{item.tier}</p><dl class="mt-4 grid gap-3 text-sm"><div><dt class="text-xs text-sand-300">Evidence used</dt><dd class="mt-1 text-sand-100">{item.evidence}</dd></div><div><dt class="text-xs text-sand-300">Next check</dt><dd class="mt-1 text-sand-100">{item.next}</dd></div></dl></article>)}
      </div>
    </section>

    <section class="mt-16" aria-labelledby="budget-title">
      <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Lowest reported buy-in</p>
      <h2 id="budget-title" class="mt-3 text-3xl font-bold tracking-[-.03em]">Best Budget Seeds for Learning the Current Loop</h2>
      <p class="mt-4 max-w-3xl leading-7 text-sand-300">These are ordered by reported shop price, not by profit. That makes the list useful for controlling downside while you collect your own harvest and timing data.</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {budgetSeeds.map((seed, index) => <article class="rounded-2xl border border-line bg-ink-900 p-5"><p class="font-mono text-xs text-sand-300">#{index + 1} by buy-in</p><h3 class="mt-2 text-lg font-bold">{seed.name}</h3><p class="mt-4 font-mono text-2xl font-bold text-leaf-400">{seed.costDisplay}</p><p class="mt-2 text-sm text-sand-300">{seed.rarity} · {spawn(seed.spawnOneIn)}</p></article>)}
      </div>
    </section>

    <section class="mt-16" aria-labelledby="rare-title">
      <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-amber-300">Largest spawn denominators</p>
      <h2 id="rare-title" class="mt-3 text-3xl font-bold tracking-[-.03em]">Rarest Reported Seeds to Watch in the River</h2>
      <p class="mt-4 max-w-3xl leading-7 text-sand-300">A larger denominator means a rarer reported appearance. Do not buy automatically: compare the live price with your recovery reserve first.</p>
      <div class="mt-8 hidden overflow-x-auto rounded-2xl border border-line md:block"><table class="w-full min-w-[680px] text-left text-sm"><thead class="bg-ink-900 font-mono text-xs uppercase tracking-[.12em] text-sand-300"><tr><th class="px-5 py-4">Seed</th><th class="px-5 py-4">Rarity</th><th class="px-5 py-4">Reported price</th><th class="px-5 py-4">Spawn chance</th><th class="px-5 py-4">Decision check</th></tr></thead><tbody>{rarestSeeds.map((seed) => <tr class="border-t border-line bg-ink-950/40"><td class="px-5 py-4 font-bold">{seed.name}</td><td class="px-5 py-4">{seed.rarity}</td><td class="px-5 py-4 font-mono">{seed.costDisplay}</td><td class="px-5 py-4 text-leaf-400">{spawn(seed.spawnOneIn)}</td><td class="px-5 py-4 text-sand-300">Verify the live listing before spending</td></tr>)}</tbody></table></div>
      <div class="mt-6 grid gap-3 md:hidden" data-mobile-rare-seeds>{rarestSeeds.map((seed) => <article class="rounded-2xl border border-line bg-ink-900 p-4"><div class="flex items-start justify-between gap-3"><div><h3 class="font-bold text-white">{seed.name}</h3><p class="mt-1 text-xs text-sand-300">{seed.rarity}</p></div><p class="font-mono font-bold text-leaf-400">{spawn(seed.spawnOneIn)}</p></div><p class="mt-4 text-sm text-sand-300">Reported price <strong class="text-sand-100">{seed.costDisplay}</strong></p><p class="mt-2 text-xs leading-5 text-amber-100">Verify the live listing before spending.</p></article>)}</div>
    </section>

    <section class="mt-16 grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl border border-amber-400/25 bg-amber-300/[.06] p-6 sm:p-8"><h2 class="text-2xl font-bold text-amber-100">Ranking Limits</h2><p class="mt-4 leading-7 text-sand-300">We removed the former “profit per minute” and S–D tier rankings because they came from an incompatible older 12-seed economy. The current sources do not provide reproducible harvest value, growth time, mutation multiplier, or lightning-loss data. Publishing a universal winner would manufacture certainty.</p></article>
      <article class="rounded-3xl border border-leaf-500/25 bg-leaf-500/[.045] p-6 sm:p-8"><h2 class="text-2xl font-bold">How to Find Your Best Seed</h2><ol class="mt-4 grid gap-3 text-sm leading-6 text-sand-300"><li><strong class="text-sand-100">1.</strong> Pick a seed whose price leaves a two-failure reserve.</li><li><strong class="text-sand-100">2.</strong> Record cost, wait time, final harvest, and failed attempts.</li><li><strong class="text-sand-100">3.</strong> Repeat under the same conditions before changing seed or fertilizer.</li><li><strong class="text-sand-100">4.</strong> Compare expected profit in the calculator using your own observations.</li></ol></article>
    </section>

    <section class="mt-12 rounded-2xl border border-line bg-ink-900 p-6"><h2 class="text-xl font-bold">Evidence behind this guide</h2><p class="mt-3 text-sm leading-6 text-sand-300">The price, rarity, and spawn figures match across {sourceItems.map((source) => source.name).join(' and ')} and were checked {site.checkedAt}. They remain third-party reports for Update 1.2.</p></section>

    <nav class="mt-14 flex flex-wrap gap-3" aria-label="Continue from the best seeds guide"><a href="/seeds/list/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Search the full Seed List</a><a href="/mechanics/mutations/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Understand mutations</a><a href="/" class="rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Calculate with observed data</a></nav>
  </section>
</BaseLayout>
