---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeStatus from '../components/CodeStatus.astro';
import EvidenceBar from '../components/EvidenceBar.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SourceList from '../components/SourceList.astro';
import Icon from '../components/Icon.astro';
import communityLinks from '../data/community-links.json';
import { evidenceByPage } from '../data/evidence';
import { codes, site, sources } from '../lib/content';
import { absoluteUrl, buildBreadcrumbSchema, codeLanguageAlternates, pageSeo } from '../lib/seo';

const activeCodes = codes.filter((code) => code.status === 'active');
const expiredCodes = codes.filter((code) => code.status === 'expired');
const checkedLabel = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${evidenceByPage.codes.lastChecked}T00:00:00Z`));
const discordCheckedLabel = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${communityLinks.discord.checkedAt}T00:00:00Z`));

const redeemSteps = [
  ['Join the official experience', 'Open Greedy Growers from the official Roblox page and load a normal server.'],
  ['Open Settings', 'Public trackers report a code field in Settings; confirm the current interface before relying on it.'],
  ['Paste the exact code', 'Keep capitalization and spacing exactly as the creator-owned source publishes them.'],
  ['Submit and verify', 'Treat a code as valid only when the game accepts it and the reward appears in your session.'],
];
const failureReasons = [
  ['The code is not real', 'Skip attractive reward strings that have no source trail or in-game result.'],
  ['The code expired', 'Update and milestone rewards can disappear quickly, so compare dates.'],
  ['The text was copied incorrectly', 'Extra spaces, changed capitalization, and similar characters can fail.'],
  ['The source is not official', 'A creator-owned Roblox or in-game announcement is stronger than a repost.'],
];
const faqs = [
  ['Are there working Greedy Growers codes?', 'No active code is currently verified by this guide. The status will change only after a reproducible source or in-game result is recorded.'],
  ['Where do Greedy Growers codes come from?', 'Treat creator-owned Roblox pages and in-game announcements as stronger evidence than copied lists or reposts.'],
  ['Why do Greedy Growers codes expire?', 'Event, update, and milestone rewards may be removed without notice, so every record needs a source and check date.'],
  ['Where is the Greedy Growers redeem box?', 'Secondary guides report a code field in Settings. Confirm the current game interface before relying on that route.'],
];
const metadata = pageSeo.codes;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: metadata.h1,
    description: metadata.description,
    url: absoluteUrl(metadata.canonicalPath),
    dateModified: evidenceByPage.codes.lastChecked,
  },
  buildBreadcrumbSchema([
    { name: 'Greedy Growers Hub', path: '/' },
    { name: 'Greedy Growers Codes', path: metadata.canonicalPath },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schemas} alternates={codeLanguageAlternates}>
  <section class="border-b border-line bg-ink-900/60">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-leaf-400">Roblox codes guide</p>
      <h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-sand-300">Check the current answer before you paste anything. This page keeps active, expired, reported, and unverified claims separate.</p>
      <EvidenceBar {...evidenceByPage.codes} />
      <div class="mt-6 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4" aria-label="Current Greedy Growers code summary">
        <p class="bg-ink-950 px-4 py-3 font-mono text-xs text-sand-100">Active: {activeCodes.length}</p>
        <p class="bg-ink-950 px-4 py-3 font-mono text-xs text-sand-100">Expired: {expiredCodes.length}</p>
        <p class="bg-ink-950 px-4 py-3 font-mono text-xs text-sand-100">Redeem: Settings (reported, not in-game verified)</p>
        <p class="bg-ink-950 px-4 py-3 font-mono text-xs text-sand-100">Last checked: <time datetime={evidenceByPage.codes.lastChecked}>{checkedLabel}</time></p>
      </div>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="#current-status" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Check code status</a>
        <a href={site.officialGameUrl} target="_blank" rel="noopener noreferrer" data-event="play_roblox_click" class="inline-flex items-center gap-2 rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Open Roblox <Icon name="external" size={15}/></a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl space-y-16 px-4 py-16 sm:px-6 lg:px-8">
    <section id="current-status" class="scroll-mt-24">
      <SectionHeading eyebrow="Current answer" title="Are There Any Working Greedy Growers Codes?" description={`No active Greedy Growers code is verified as of ${checkedLabel}. Two current trackers report an empty active list, and this project has no recorded in-game redemption.`}/>
      <aside class="mt-8 rounded-2xl border border-leaf-500/25 bg-leaf-500/[.055] p-6">
        <p class="font-display text-2xl font-bold text-white">Current verified answer: 0 working codes</p>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-sand-300">Zero is a dated result, not a claim that codes never existed. A code moves into the verified list only after a traceable current source and a reproducible in-game reward.</p>
      </aside>
    </section>

    <section id="active-codes" class="scroll-mt-24">
      <SectionHeading eyebrow="Active list" title="All Active Greedy Growers Codes" description="The list remains empty until a candidate passes the source and in-game verification gates below."/>
      <div class="mt-8"><h2 class="sr-only">Three-Step Code Status</h2><CodeStatus /></div>
    </section>

    <section id="expired-codes" class="scroll-mt-24">
      <SectionHeading eyebrow="Expired history" title="Expired Greedy Growers Codes" description="No previously working code has a source-traceable expired record in this project yet."/>
      <div class="mt-8 rounded-xl border border-line bg-ink-900 p-6">
        {expiredCodes.length ? (
          <ul class="grid gap-3">{expiredCodes.map((code) => <li class="rounded-lg border border-line bg-ink-950/50 p-4"><code class="font-mono font-bold text-sand-300 line-through">{code.code}</code><p class="mt-2 text-sm text-sand-300">{code.reward}</p></li>)}</ul>
        ) : <p class="text-sm leading-6 text-sand-300">Expired: 0. Future history must retain the exact code, reward, original source, and the date it stopped working.</p>}
      </div>
    </section>

    <section id="redeem-codes" class="scroll-mt-24">
      <SectionHeading eyebrow="Redeem route" title="How to Redeem Codes in Greedy Growers" description="Current public trackers report this Settings route. Treat it as reported until an original current-version screenshot or recorded session verifies the interface."/>
      <ol class="mt-8 grid gap-4 md:grid-cols-2">{redeemSteps.map(([title, description], index) => <li class="rounded-xl border border-line bg-ink-900 p-5"><div class="flex items-center gap-3"><span class="grid size-8 place-items-center rounded-md bg-leaf-500 font-mono text-xs font-bold text-ink-950">{index + 1}</span><h3 class="font-display font-bold text-white">{title}</h3></div><p class="mt-4 text-sm leading-6 text-sand-300">{description}</p></li>)}</ol>
    </section>

    <section id="code-not-working" class="scroll-mt-24">
      <SectionHeading eyebrow="Troubleshooting" title="Why Is My Greedy Growers Code Not Working?" description="Rule out an invented, expired, mistyped, or weakly sourced code before retrying."/>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">{failureReasons.map(([title, description]) => <article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="flex items-center gap-2 font-display font-bold text-white"><Icon name="warning" size={17} class="text-amber-300"/>{title}</h3><p class="mt-3 text-sm leading-6 text-sand-300">{description}</p></article>)}</div>
    </section>

    <section id="new-code-sources" class="scroll-mt-24">
      <SectionHeading eyebrow="Release sources" title="Where Are New Greedy Growers Codes Released?" description="Start with creator-owned Roblox surfaces. Secondary trackers are useful leads, but copied Discord invites or reward strings do not become official by repetition."/>
      <div class="mt-8"><SourceList items={sources.filter((source) => ['roblox-official', 'pro-game-guides-codes', 'mrguider-codes'].includes(source.id))} title="Sources checked for the August 11 code status" /></div>
      <aside class="mt-5 rounded-xl border border-amber-400/25 bg-amber-400/[.055] p-5" role="note">
        <p class="font-display font-bold text-white">Official Discord: Unverified as of {discordCheckedLabel}</p>
        <p class="mt-2 text-sm leading-6 text-sand-300">{communityLinks.discord.note} No Discord link is published here until a creator-owned source can be reproduced.</p><a href="/official-links/" class="mt-4 inline-flex text-sm font-bold text-leaf-400">Review official link status →</a>
      </aside>
    </section>

    <section>
      <SectionHeading eyebrow="Codes FAQ" title="Codes FAQ and Verification Method"/>
      <div class="mt-8 grid gap-3">{faqs.map(([question, answer]) => <details class="rounded-xl border border-line bg-ink-900 p-5"><summary class="cursor-pointer font-display font-bold text-white">{question}</summary><p class="mt-4 text-sm leading-6 text-sand-300">{answer}</p></details>)}</div>
      <nav class="mt-8 flex flex-wrap gap-3" aria-label="Continue with Greedy Growers tools"><a href="/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Calculate how rewards affect profit</a><a href="/beginner-guide/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Start with the Greedy Growers beginner guide</a></nav>
    </section>
  </div>
</BaseLayout>
