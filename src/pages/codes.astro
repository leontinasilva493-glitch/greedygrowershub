---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeStatus from '../components/CodeStatus.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SourceList from '../components/SourceList.astro';
import Icon from '../components/Icon.astro';
import { site, sources } from '../lib/content';

const redeemSteps = [
  ['Join the official experience', 'Open Greedy Growers from the official Roblox page and load a normal server.'],
  ['Open Settings', 'Public trackers report a code field in Settings; confirm the current interface before relying on it.'],
  ['Paste the exact code', 'Keep capitalization and spacing exactly as the creator-owned source publishes them.'],
  ['Submit and verify', 'Treat a code as valid only when the game accepts it and the reward appears in your session.'],
];
const failureReasons = [
  ['The code is not real', 'Skip attractive reward strings that have no source trail or in-game result.'],
  ['The code expired', 'Update and milestone rewards can disappear quickly, so compare dates.'],
  ['The text was copied incorrectly', 'Extra spaces, changed capitalization, and similar characters can fail.'],
  ['The source is not official', 'A creator-owned Roblox or in-game announcement is stronger than a repost.'],
];
---

<BaseLayout title="Greedy Growers Codes — Current Status & Redeem Guide" description="Check current Greedy Growers code status, redemption steps, expired history, and trusted sources." canonicalPath="/codes">
  <section class="border-b border-line bg-ink-900/60"><div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8"><p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-leaf-400">Roblox codes guide</p><h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">Greedy Growers Codes</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-sand-300">Check the current answer before you paste anything. This page keeps active, expired, reported, and unverified claims separate.</p><div class="mt-7 flex flex-wrap gap-3"><a href="#current-status" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Check code status</a><a href={site.officialGameUrl} target="_blank" rel="noopener noreferrer" data-event="play_roblox_click" class="inline-flex items-center gap-2 rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Open Roblox <Icon name="external" size={15}/></a></div></div></section>
  <div class="mx-auto max-w-7xl space-y-16 px-4 py-16 sm:px-6 lg:px-8">
    <section id="current-status"><SectionHeading eyebrow="Current answer" title="No reliable active codes found" description={`Last checked ${site.checkedAt}. The safe answer is an empty verified list until a creator-owned source or repeatable in-game result provides a working code.`}/><div class="mt-8"><CodeStatus /></div></section>
    <section><SectionHeading eyebrow="Redeem route" title="How to redeem a code when one appears" description="These are reported check steps, not proof that an active code currently exists."/><ol class="mt-8 grid gap-4 md:grid-cols-2">{redeemSteps.map(([title, description], index) => <li class="rounded-xl border border-line bg-ink-900 p-5"><div class="flex items-center gap-3"><span class="grid size-8 place-items-center rounded-md bg-leaf-500 font-mono text-xs font-bold text-ink-950">{index + 1}</span><h3 class="font-display font-bold text-white">{title}</h3></div><p class="mt-4 text-sm leading-6 text-sand-300">{description}</p></li>)}</ol></section>
    <section><SectionHeading eyebrow="Troubleshooting" title="Why a Greedy Growers code may not work"/><div class="mt-8 grid gap-4 sm:grid-cols-2">{failureReasons.map(([title, description]) => <article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="flex items-center gap-2 font-display font-bold text-white"><Icon name="warning" size={17} class="text-amber-300"/>{title}</h3><p class="mt-3 text-sm leading-6 text-sand-300">{description}</p></article>)}</div></section>
    <SourceList items={sources} title="Last checked and claim strength" />
    <section><SectionHeading eyebrow="Codes FAQ" title="Quick answers"/><div class="mt-8 grid gap-3"><details class="rounded-xl border border-line bg-ink-900 p-5"><summary class="cursor-pointer font-display font-bold text-white">Are there working Greedy Growers codes?</summary><p class="mt-4 text-sm leading-6 text-sand-300">No active code is currently verified by this guide.</p></details><details class="rounded-xl border border-line bg-ink-900 p-5"><summary class="cursor-pointer font-display font-bold text-white">Where is the redeem box?</summary><p class="mt-4 text-sm leading-6 text-sand-300">Secondary guides report a Settings code field. Confirm the current game interface when a real code is published.</p></details></div></section>
  </div>
</BaseLayout>
