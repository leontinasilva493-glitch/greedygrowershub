---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeStatus from '../components/CodeStatus.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SourceList from '../components/SourceList.astro';
import Icon from '../components/Icon.astro';
import { site, sources } from '../lib/content';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../lib/seo';

const redeemSteps = [
  ['Join the official experience', 'Open Greedy Growers from the official Roblox page and load a normal server.'],
  ['Open Settings', 'Public trackers report a code field in Settings; confirm the current interface before relying on it.'],
  ['Paste the exact code', 'Keep capitalization and spacing exactly as the creator-owned source publishes them.'],
  ['Submit and verify', 'Treat a code as valid only when the game accepts it and the reward appears in your session.'],
];
const failureReasons = [
  ['The code is not real', 'Skip attractive reward strings that have no source trail or in-game result.'],
  ['The code expired', 'Update and milestone rewards can disappear quickly, so compare dates.'],
  ['The text was copied incorrectly', 'Extra spaces, changed capitalization, and similar characters can fail.'],
  ['The source is not official', 'A creator-owned Roblox or in-game announcement is stronger than a repost.'],
];
const faqs = [
  ['Are there working Greedy Growers codes?', 'No active code is currently verified by this guide. The status will change only after a reproducible source or in-game result is recorded.'],
  ['Where do Greedy Growers codes come from?', 'Treat creator-owned Roblox pages and in-game announcements as stronger evidence than copied lists or reposts.'],
  ['Why do Greedy Growers codes expire?', 'Event, update, and milestone rewards may be removed without notice, so every record needs a source and check date.'],
  ['Where is the Greedy Growers redeem box?', 'Secondary guides report a code field in Settings. Confirm the current game interface before relying on that route.'],
];
const metadata = pageSeo.codes;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: metadata.h1,
    description: metadata.description,
    url: absoluteUrl(metadata.canonicalPath),
    dateModified: site.checkedAt,
  },
  buildBreadcrumbSchema([
    { name: 'Greedy Growers Hub', path: '/' },
    { name: 'Greedy Growers Codes', path: metadata.canonicalPath },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schemas}>
  <section class="border-b border-line bg-ink-900/60"><div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8"><p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-leaf-400">Roblox codes guide</p><h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-sand-300">Check the current answer before you paste anything. This page keeps active, expired, reported, and unverified claims separate.</p><div class="mt-7 flex flex-wrap gap-3"><a href="#current-status" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Check code status</a><a href={site.officialGameUrl} target="_blank" rel="noopener noreferrer" data-event="play_roblox_click" class="inline-flex items-center gap-2 rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Open Roblox <Icon name="external" size={15}/></a></div></div></section>
  <div class="mx-auto max-w-7xl space-y-16 px-4 py-16 sm:px-6 lg:px-8">
    <section id="current-status"><SectionHeading eyebrow="Current answer" title="Active Greedy Growers codes - verified status" description={`Last checked ${site.checkedAt}. The safe answer is an empty verified list until a creator-owned source or repeatable in-game result provides a working code.`}/><div class="mt-8"><CodeStatus /></div></section>
    <section><SectionHeading eyebrow="Redeem route" title="How to redeem codes in Greedy Growers" description="These are reported check steps, not proof that an active code currently exists."/><ol class="mt-8 grid gap-4 md:grid-cols-2">{redeemSteps.map(([title, description], index) => <li class="rounded-xl border border-line bg-ink-900 p-5"><div class="flex items-center gap-3"><span class="grid size-8 place-items-center rounded-md bg-leaf-500 font-mono text-xs font-bold text-ink-950">{index + 1}</span><h3 class="font-display font-bold text-white">{title}</h3></div><p class="mt-4 text-sm leading-6 text-sand-300">{description}</p></li>)}</ol></section>
    <section><SectionHeading eyebrow="Troubleshooting" title="Why a Greedy Growers code may not work"/><div class="mt-8 grid gap-4 sm:grid-cols-2">{failureReasons.map(([title, description]) => <article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="flex items-center gap-2 font-display font-bold text-white"><Icon name="warning" size={17} class="text-amber-300"/>{title}</h3><p class="mt-3 text-sm leading-6 text-sand-300">{description}</p></article>)}</div></section>
    <SourceList items={sources} title="Last checked and claim strength" />
    <section><SectionHeading eyebrow="Codes FAQ" title="Greedy Growers codes questions"/><div class="mt-8 grid gap-3">{faqs.map(([question, answer]) => <details class="rounded-xl border border-line bg-ink-900 p-5"><summary class="cursor-pointer font-display font-bold text-white">{question}</summary><p class="mt-4 text-sm leading-6 text-sand-300">{answer}</p></details>)}</div><nav class="mt-8 flex flex-wrap gap-3" aria-label="Continue with Greedy Growers tools"><a href="/calculator/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Calculate how rewards affect profit</a><a href="/beginner-guide/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Start with the Greedy Growers beginner guide</a></nav></section>
  </div>
</BaseLayout>
