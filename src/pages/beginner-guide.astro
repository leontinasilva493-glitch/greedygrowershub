---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteSteps from '../components/RouteSteps.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SourceList from '../components/SourceList.astro';
import Icon from '../components/Icon.astro';
import { site, sources } from '../lib/content';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../lib/seo';

const steps = [
  { title: 'Open the official experience', description: 'Start from the official Roblox page so you can verify the experience and creator before joining.', label: 'Official' },
  { title: 'Buy one seed from the river', description: 'The official description points players to the river for seed buying. Keep the first purchase simple.', label: 'Official' },
  { title: 'Plant it in your plot', description: 'Return to your own plot, plant the seed, and keep the tree visible while learning the loop.', label: 'Official' },
  { title: 'Watch the tree grow', description: 'Height creates temptation, but published sources do not provide a reliable public timer or lightning probability.', label: 'Official boundary' },
  { title: 'Harvest before lightning', description: 'Cash out earlier on first runs. Extend the wait only after you understand what the current server shows.', label: 'Official + editorial' },
];
const mistakes = [
  ['Joining clone links', 'Open the experience through Roblox before following reposted servers or social invitations.'],
  ['Waiting for maximum height immediately', 'Your first goal is learning the harvest action, not proving how long one tree can survive.'],
  ['Chasing codes first', 'No verified active code currently improves the basic buy, plant, watch, and harvest loop.'],
  ['Trusting unsourced seed tiers', 'A useful ranking needs names, costs, outcomes, conditions, and a checked date.'],
];
const metadata = pageSeo.beginnerGuide;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: metadata.h1,
    description: metadata.description,
    mainEntityOfPage: absoluteUrl(metadata.canonicalPath),
    dateModified: site.checkedAt,
    author: { '@type': 'Organization', name: site.name },
    publisher: { '@type': 'Organization', name: site.name },
  },
  buildBreadcrumbSchema([
    { name: 'Greedy Growers Calculator', path: '/' },
    { name: 'Greedy Growers Beginner Guide', path: metadata.canonicalPath },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to complete your first Greedy Growers harvest',
    description: 'Follow the public river-to-plot game loop without relying on unverified timers or seed rankings.',
    step: steps.map((step, index) => ({
      '@type': 'HowToStep',
      position: index + 1,
      name: step.title,
      text: step.description,
    })),
  },
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schemas}>
  <section class="border-b border-line bg-[radial-gradient(circle_at_70%_20%,rgba(101,229,114,.14),transparent_38%)]"><div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8"><p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-leaf-400">Roblox beginner guide</p><h1 class="mt-4 max-w-4xl font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-sand-300">Learn the official loop first. A clean early cash-out teaches more than an unsupported timer, seed tier, or perfect-height promise.</p><div class="mt-7 flex flex-wrap gap-3"><a href="#first-route" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Start first harvest</a><a href={site.officialGameUrl} target="_blank" rel="noopener noreferrer" data-event="play_roblox_click" class="inline-flex items-center gap-2 rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Play on Roblox <Icon name="external" size={15}/></a></div></div></section>
  <div class="mx-auto max-w-7xl space-y-16 px-4 py-16 sm:px-6 lg:px-8">
    <section id="first-route"><SectionHeading eyebrow="Immediate route" title="Greedy Growers first harvest route" description="Five steps from the official listing, with cautious beginner guidance where public game values stop."/><div class="mt-8"><RouteSteps steps={steps}/></div></section>
    <section class="grid gap-8 rounded-2xl border border-line bg-ink-900 p-6 lg:grid-cols-[.8fr_1.2fr] sm:p-8"><SectionHeading eyebrow="Mechanics handoff" title="Learn harvest timing after the first clean run" description="This beginner page stops after the first cash-out. Lightning facts and conservative, balanced, or maximum-greed timing live in Mechanics."/><div class="grid content-center gap-3"><a href="/mechanics/lightning/" class="rounded-xl border border-line bg-ink-950/60 p-5 no-underline"><h3 class="font-display font-bold text-white">Read verified lightning boundaries</h3><p class="mt-2 text-sm text-sand-300">Separate official facts from community timing claims.</p></a><a href="/mechanics/when-to-harvest/" class="rounded-xl border border-leaf-500/35 bg-leaf-500/[.045] p-5 no-underline"><h3 class="font-display font-bold text-white">Choose when to harvest</h3><p class="mt-2 text-sm text-sand-300">Compare capital-first and high-risk strategies after you know the basic controls.</p></a></div></section>
    <section><SectionHeading eyebrow="Early mistakes" title="Greedy Growers beginner mistakes"/><div class="mt-8 grid gap-4 md:grid-cols-2">{mistakes.map(([title, description]) => <article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-display font-bold text-white">{title}</h3><p class="mt-3 text-sm leading-6 text-sand-300">{description}</p></article>)}</div></section>
    <section class="rounded-2xl border border-leaf-500/25 bg-leaf-500/[.055] p-6 sm:p-8"><SectionHeading eyebrow="Next choices" title="Compare seeds and calculate profit" description="After one complete run, use the Seeds page to record what is known and the Calculator to compare cost, value, time, and failures."/><div class="mt-7 flex flex-wrap gap-3"><a href="/seeds/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Compare Greedy Growers seed records</a><a href="/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Calculate your planting profit</a><a href="/guides/get-money-fast/" class="rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Learn how to protect starting coins</a></div></section>
    <SourceList items={sources.slice(0, 3)} title="Last checked and claim strength" />
  </div>
</BaseLayout>
