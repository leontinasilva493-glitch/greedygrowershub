---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatusBadge from '../components/StatusBadge.astro';
import gameStatus from '../data/game-status.json';
import { site } from '../lib/content';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../lib/seo';

const metadata = pageSeo.updates;
const officialUpdatedLabel = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'UTC',
  timeZoneName: 'short',
}).format(new Date(gameStatus.updated));
const entries = [
  {
    date: gameStatus.updated.slice(0, 10),
    label: 'Official API signal',
    state: 'verified' as const,
    title: 'Roblox listing updated',
    details: `The official Roblox Games API reports ${gameStatus.updated} as the experience updated time. That signal tells us when to recheck change-sensitive pages; it does not describe the patch contents by itself.`,
    links: [
      { label: 'Codes', href: '/codes/' },
      { label: 'Seed List', href: '/seeds/list/' },
      { label: 'Mutations', href: '/mechanics/mutations/' },
      { label: 'Progression', href: '/guides/progression/' },
    ],
  },
  {
    date: '2026-08-01',
    label: 'Data update',
    state: 'community' as const,
    title: 'Current 20-seed Update 1.2 catalog added',
    details: 'Replaced the incompatible 12-seed snapshot with 20 names, prices, rarities, and spawn chances that match across two current guides. Removed unsupported profit tiers and old economics from related pages.',
    links: [
      { label: 'Seed List', href: '/seeds/list/' },
      { label: 'Best Seeds', href: '/seeds/best/' },
      { label: 'Calculator', href: '/' },
      { label: 'Money Guide', href: '/guides/get-money-fast/' },
    ],
  },
  {
    date: '2026-08-01',
    label: 'Data update',
    state: 'community' as const,
    title: 'Mutations mechanics cluster added',
    details: 'Added six source-matched mutation multipliers and reported triggers, while keeping stacking math and unverified server behavior outside the calculator.',
    links: [
      { label: 'Mutations', href: '/mechanics/mutations/' },
      { label: 'Mechanics', href: '/mechanics/' },
      { label: 'Lightning', href: '/mechanics/lightning/' },
      { label: 'Seed List', href: '/seeds/list/' },
    ],
  },
];
const revisionEntries = [
  { date: '2026-07-26', title: 'Problem-focused guide expansion', details: 'Added Mechanics, Money, Progression, Tickets, and Best Seeds coverage, with player videos placed beside the claims they help evaluate.' },
  { date: '2026-07-26', title: 'Legacy calculator snapshot imported', details: 'The historical import contained 12 seeds, 3 fertilizers, 5 rebirth levels, and community tiers. Its seed economics and rankings were retired on 2026-08-01 after a current-version conflict was found.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: metadata.h1, description: metadata.description, url: absoluteUrl(metadata.canonicalPath), dateModified: site.checkedAt },
  buildBreadcrumbSchema([{ name: 'Greedy Growers Calculator', path: '/' }, { name: 'Updates', path: metadata.canonicalPath }]),
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schema}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-4xl"><p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Freshness center</p><h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1><p class="mt-5 text-lg leading-8 text-sand-300">Track which game signals and site datasets changed, which pages they affect, and what still needs a current in-game check.</p></div>

    <aside class="mt-10 grid gap-5 rounded-2xl border border-leaf-500/25 bg-leaf-500/[.055] p-6 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-leaf-400">Roblox official updated time</p>
        <p class="mt-3 font-display text-2xl font-bold text-white"><time datetime={gameStatus.updated}>{officialUpdatedLabel}</time></p>
        <p class="mt-2 text-sm leading-6 text-sand-300">Pulled from the official Games API for universe {gameStatus.universeId}; snapshot checked {gameStatus.checkedAt}. This timestamp is an update signal, not an official changelog.</p>
      </div>
      <a href={gameStatus.sourceUrl} target="_blank" rel="noopener noreferrer" class="rounded-md border border-leaf-500/35 px-4 py-2.5 text-sm font-bold text-leaf-400 no-underline">Open API source →</a>
    </aside>

    <section class="mt-16"><SectionHeading eyebrow="Current player-facing status" title="Latest Greedy Growers Game and Data Updates" description="Game signals and data revisions are labeled separately, with direct links to every page that needs a recheck."/><h2 class="sr-only">Pages affected by the latest Roblox update signal</h2><div class="mt-8 grid gap-5">{entries.map((entry) => <article class="grid gap-5 rounded-2xl border border-line bg-ink-900 p-6 md:grid-cols-[9rem_1fr]"><div><p class="font-mono text-sm text-leaf-400">{entry.date}</p><div class="mt-3"><StatusBadge state={entry.state} label={entry.label}/></div></div><div><h3 class="font-display text-xl font-bold text-white">{entry.title}</h3><p class="mt-3 text-sm leading-6 text-sand-300">{entry.details}</p><div class="mt-4 flex flex-wrap gap-2" aria-label={`Pages affected by ${entry.title}`}>{entry.links.map((link) => <a href={link.href} class="rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-leaf-400 no-underline hover:border-leaf-500/50 hover:text-leaf-300">{link.label}</a>)}</div></div></article>)}</div></section>

    <section class="mt-16"><SectionHeading eyebrow="Editorial history" title="Site Data Revision History" description="Older site changes stay visible for accountability but are kept separate from game-update signals."/><div class="mt-8 grid gap-4 md:grid-cols-2">{revisionEntries.map((entry) => <article class="rounded-2xl border border-line bg-ink-900 p-6"><p class="font-mono text-sm text-leaf-400">{entry.date}</p><h3 class="mt-3 font-display text-lg font-bold text-white">{entry.title}</h3><p class="mt-3 text-sm leading-6 text-sand-300">{entry.details}</p></article>)}</div></section>

    <section class="mt-16"><SectionHeading eyebrow="Codes status" title="Codes Status After Game Updates" description="Codes can appear around patches, events, or milestones, so their page owns the active and expired status instead of duplicating lists here."/><div class="mt-8 rounded-2xl border border-line bg-ink-900 p-6"><h3 class="font-display text-xl font-bold text-white">Current site position</h3><p class="mt-3 text-sm leading-6 text-sand-300">No active code is labeled verified without a creator-owned source or repeatable in-game result. Open the Codes page for the latest check date and redeem troubleshooting.</p><a href="/codes/" class="mt-5 inline-flex font-bold text-leaf-400">Check Greedy Growers codes →</a></div></section>

    <section class="mt-16"><SectionHeading eyebrow="Official and community links" title="Official Sources for Greedy Growers Updates" description="Start with creator-owned Roblox surfaces, then use community videos or guide sites as leads that still require comparison."/><div class="mt-8 grid gap-4 md:grid-cols-3"><article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Official Roblox page</h3><p class="mt-2 text-sm text-sand-300">Confirm game identity, creator, description, availability, and public update text.</p><a class="mt-4 inline-flex text-sm font-bold text-leaf-400" href={site.officialGameUrl} target="_blank" rel="noopener noreferrer">Open Roblox →</a></article><article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Official Discord</h3><p class="mt-2 text-sm text-sand-300">A public creator-owned invite is not verified in this project. Do not trust copied invite links without a Roblox or creator source.</p></article><article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Creator videos</h3><p class="mt-2 text-sm text-sand-300">Use them to discover tests, then reproduce the inputs before converting experience into a mechanic claim.</p></article></div></section>

    <section class="mt-16"><SectionHeading eyebrow="After every patch" title="What We Recheck After Every Patch" description="Update-sensitive pages should be reviewed in the order that most directly affects a player's next decision."/><ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{['Codes and redeem UI','Seed, mutation, and fertilizer values','Tickets and progression unlocks','Lightning and harvest behavior'].map((item, index) => <li class="rounded-xl border border-line bg-ink-900 p-5"><span class="font-mono text-leaf-400">0{index + 1}</span><h3 class="mt-3 font-bold text-white">{item}</h3></li>)}</ol></section>

    <nav class="mt-14 flex flex-wrap gap-3"><a href="/codes/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Check Codes</a><a href="/seeds/list/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Review seed data</a><a href="/mechanics/" class="rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Review Mechanics</a></nav>
  </section>
</BaseLayout>
