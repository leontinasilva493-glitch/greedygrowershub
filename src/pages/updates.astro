---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { site } from '../lib/content';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../lib/seo';

const metadata = pageSeo.updates;
const entries = [
  { date: '2026-07-26', title: 'Mechanics, money, progression, Tickets, and Best Seeds expansion', details: 'Added problem-focused content clusters and moved player videos into the pages that evaluate their claims.', affected: ['Calculator', 'Guides', 'Seeds', 'Mechanics'] },
  { date: '2026-07-26', title: 'Community calculator and tier snapshot imported', details: 'Added 12 seeds, 3 fertilizers, 5 rebirth levels, and community tier assignments. All copied values remain pending an in-game recheck.', affected: ['Calculator', 'Seed List', 'Best Seeds', 'Progression'] },
  { date: '2026-07-22', title: 'Roblox listing update signal', details: 'A reported game update may affect code status, seed values, progression unlocks, and harvest strategy. Recheck older claims before using them.', affected: ['Codes', 'Tickets', 'Lightning', 'Progression'] },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: metadata.h1, description: metadata.description, url: absoluteUrl(metadata.canonicalPath), dateModified: site.checkedAt },
  buildBreadcrumbSchema([{ name: 'Greedy Growers Calculator', path: '/' }, { name: 'Updates', path: metadata.canonicalPath }]),
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schema}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-4xl"><p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Freshness center</p><h1 class="mt-4 font-display text-4xl font-bold tracking-[-.045em] text-white sm:text-6xl">{metadata.h1}</h1><p class="mt-5 text-lg leading-8 text-sand-300">Track which game signals and site datasets changed, which pages they affect, and what still needs a current in-game check.</p></div>

    <section class="mt-16"><SectionHeading eyebrow="Latest update" title="Greedy Growers update timeline" description="Each entry names the affected pages so an old number or strategy can be rechecked instead of silently staying live."/><div class="mt-8 grid gap-5">{entries.map((entry, index) => <article class="grid gap-5 rounded-2xl border border-line bg-ink-900 p-6 md:grid-cols-[9rem_1fr]"><div><p class="font-mono text-sm text-leaf-400">{entry.date}</p><div class="mt-3"><StatusBadge state={index === 2 ? 'reported' : 'community'} label={index === 2 ? 'Game signal' : 'Site update'}/></div></div><div><h3 class="font-display text-xl font-bold text-white">{entry.title}</h3><p class="mt-3 text-sm leading-6 text-sand-300">{entry.details}</p><p class="mt-4 text-xs text-sand-300">Affected: {entry.affected.join(' · ')}</p></div></article>)}</div></section>

    <section class="mt-16"><SectionHeading eyebrow="Codes status" title="Recheck Greedy Growers codes after updates" description="Codes can appear around patches, events, or milestones, so their page owns the active and expired status instead of duplicating lists here."/><div class="mt-8 rounded-2xl border border-line bg-ink-900 p-6"><h3 class="font-display text-xl font-bold text-white">Current site position</h3><p class="mt-3 text-sm leading-6 text-sand-300">No active code is labeled verified without a creator-owned source or repeatable in-game result. Open the Codes page for the latest check date and redeem troubleshooting.</p><a href="/codes/" class="mt-5 inline-flex font-bold text-leaf-400">Check Greedy Growers codes →</a></div></section>

    <section class="mt-16"><SectionHeading eyebrow="Official and community links" title="Where to confirm a Greedy Growers update" description="Start with creator-owned Roblox surfaces, then use community videos or guide sites as leads that still require comparison."/><div class="mt-8 grid gap-4 md:grid-cols-3"><article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Official Roblox page</h3><p class="mt-2 text-sm text-sand-300">Confirm game identity, creator, description, availability, and public update text.</p><a class="mt-4 inline-flex text-sm font-bold text-leaf-400" href={site.officialGameUrl} target="_blank" rel="noopener noreferrer">Open Roblox →</a></article><article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Official Discord</h3><p class="mt-2 text-sm text-sand-300">A public creator-owned invite is not verified in this project. Do not trust copied invite links without a Roblox or creator source.</p></article><article class="rounded-xl border border-line bg-ink-900 p-5"><h3 class="font-bold text-white">Creator videos</h3><p class="mt-2 text-sm text-sand-300">Use them to discover tests, then reproduce the inputs before converting experience into a mechanic claim.</p></article></div></section>

    <section class="mt-16"><SectionHeading eyebrow="After every patch" title="Greedy Growers content recheck order" description="Update-sensitive pages should be reviewed in the order that most directly affects a player's next decision."/><ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{['Codes and redeem UI','Seed and fertilizer values','Tickets and progression unlocks','Lightning and harvest behavior'].map((item, index) => <li class="rounded-xl border border-line bg-ink-900 p-5"><span class="font-mono text-leaf-400">0{index + 1}</span><h3 class="mt-3 font-bold text-white">{item}</h3></li>)}</ol></section>

    <nav class="mt-14 flex flex-wrap gap-3"><a href="/codes/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Check Codes</a><a href="/seeds/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Review seed data</a><a href="/mechanics/" class="rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Review Mechanics</a></nav>
  </section>
</BaseLayout>
