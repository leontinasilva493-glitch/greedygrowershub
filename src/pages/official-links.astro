---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatusBadge from '../components/StatusBadge.astro';
import communityLinks from '../data/community-links.json';
import gameStatus from '../data/game-status.json';
import { site } from '../lib/content';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../lib/seo';

const metadata = pageSeo.officialLinks;
const checkedLabel = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${communityLinks.discord.checkedAt}T00:00:00Z`));
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: metadata.h1, description: metadata.description, url: absoluteUrl(metadata.canonicalPath), dateModified: site.checkedAt },
  buildBreadcrumbSchema([{ name: 'Greedy Growers Hub', path: '/' }, { name: 'Official Links', path: metadata.canonicalPath }]),
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schema}>
  <main class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <header class="max-w-4xl">
      <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Verified destinations before community leads</p>
      <h1 class="title-page mt-4 font-display font-bold tracking-[-.045em] text-white">{metadata.h1}</h1>
      <p class="mt-5 text-lg leading-8 text-sand-300">Use the Roblox experience as the play destination and the Games API as a dated status source. Discord and other community links stay unpublished until a creator-owned path can be reproduced.</p>
    </header>

    <section class="mt-12 grid gap-5 lg:grid-cols-3" aria-label="Greedy Growers destination status">
      <article class="rounded-2xl border border-leaf-500/30 bg-leaf-500/[.055] p-6">
        <StatusBadge state="official" label="Official destination"/>
        <h2 class="mt-4 font-display text-2xl font-bold text-white">Official Roblox experience</h2>
        <p class="mt-3 text-sm leading-6 text-sand-300">Use this listing to verify the experience name, creator attribution, device support, and public game description before joining.</p>
        <a href={site.officialGameUrl} target="_blank" rel="noopener noreferrer" data-event="play_roblox_click" class="mt-5 inline-flex items-center gap-2 font-bold text-leaf-400">Open Roblox <Icon name="external" size={15}/></a>
      </article>
      <article class="rounded-2xl border border-line bg-ink-900 p-6">
        <StatusBadge state="official" label="Official data source"/>
        <h2 class="mt-4 font-display text-2xl font-bold text-white">Roblox Games API snapshot</h2>
        <p class="mt-3 text-sm leading-6 text-sand-300">The API records the universe ID and updated timestamp. It signals when pages need review but does not describe patch contents.</p>
        <a href={gameStatus.sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 font-bold text-leaf-400">Open API source <Icon name="external" size={15}/></a>
      </article>
      <article class="rounded-2xl border border-line bg-ink-900 p-6">
        <StatusBadge state="reported" label="Creator attribution"/>
        <h2 class="mt-4 font-display text-2xl font-bold text-white">Creator ownership check</h2>
        <p class="mt-3 text-sm leading-6 text-sand-300">The official experience and API identify the creator context. Use those surfaces before trusting a group, social account, or mirrored play link.</p>
        <p class="mt-5 font-mono text-xs text-sand-300">Universe {gameStatus.universeId} · snapshot checked {site.checkedAt}</p>
      </article>
    </section>

    <section class="mt-16 rounded-3xl border border-amber-400/25 bg-amber-300/[.06] p-6 sm:p-8">
      <div class="flex flex-wrap items-center gap-3"><StatusBadge state="needs-check" label="Unverified"/><p class="font-mono text-xs uppercase tracking-[.14em] text-amber-200">Checked {checkedLabel}</p></div>
      <h2 class="mt-4 text-3xl font-bold text-white">Official Discord is not verified</h2>
      <p class="mt-4 max-w-4xl leading-7 text-sand-300">{communityLinks.discord.note} No candidate invite is published. A copied invite can expire, change ownership, or add an unsafe verification flow without warning.</p>
      <a href="/codes/" class="mt-5 inline-flex font-bold text-leaf-400">Check the dated Codes status instead →</a>
    </section>

    <section class="mt-16">
      <SectionHeading eyebrow="Publication standard" title="How We Decide a Link Is Safe to Publish" description="A navigational page is useful only when each destination has a traceable owner, a fresh check, and a clear trust label."/>
      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        <li class="rounded-xl border border-line bg-ink-900 p-5"><span class="font-mono text-leaf-400">01</span><h3 class="mt-3 font-bold text-white">Start from a creator-owned surface</h3><p class="mt-2 text-sm leading-6 text-sand-300">The Roblox experience, creator profile, or creator-controlled announcement must expose the destination.</p></li>
        <li class="rounded-xl border border-line bg-ink-900 p-5"><span class="font-mono text-leaf-400">02</span><h3 class="mt-3 font-bold text-white">Reproduce the exact URL</h3><p class="mt-2 text-sm leading-6 text-sand-300">Open the full destination without copying shortened links, invite codes, or redirects from another guide.</p></li>
        <li class="rounded-xl border border-line bg-ink-900 p-5"><span class="font-mono text-leaf-400">03</span><h3 class="mt-3 font-bold text-white">Record status and date</h3><p class="mt-2 text-sm leading-6 text-sand-300">Label official, reported, or unverified status and recheck after updates or ownership changes.</p></li>
      </ol>
    </section>

    <nav class="mt-14 flex flex-wrap gap-3" aria-label="Continue from official links"><a href="/updates/" class="rounded-md bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 no-underline">Review update signals</a><a href="/codes/" class="rounded-md border border-leaf-500/35 px-5 py-3 text-sm font-bold text-leaf-400 no-underline">Check Codes</a><a href="/contact/" class="rounded-md border border-line px-5 py-3 text-sm font-bold text-white no-underline">Prepare a source correction</a></nav>
  </main>
</BaseLayout>
