---
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl, buildBreadcrumbSchema, pageSeo } from '../lib/seo';
import { latestOfficialLinkCheck, officialLinkRecords } from '../lib/official-links';

const metadata = pageSeo.officialLinks;
const stateConfig = {
  confirmed: {
    label: 'Confirmed',
    classes: 'border-leaf-500/35 bg-leaf-500/10 text-leaf-400',
    note: 'Linked — confirmed official destination',
  },
  'needs-check': {
    label: 'Needs check',
    classes: 'border-sand-300/25 bg-white/5 text-sand-300',
    note: 'Not linked — needs verification',
  },
  unverified: {
    label: 'Unverified',
    classes: 'border-amber-400/35 bg-amber-400/10 text-amber-300',
    note: 'Not linked — unverified',
  },
} as const;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: metadata.h1,
    description: metadata.description,
    url: absoluteUrl(metadata.canonicalPath),
    dateModified: latestOfficialLinkCheck,
  },
  buildBreadcrumbSchema([
    { name: 'Greedy Growers Calculator', path: '/' },
    { name: 'Official links', path: metadata.canonicalPath },
  ]),
];
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath={metadata.canonicalPath} schema={schema}>
  <section data-official-links class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-4xl">
      <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400">Trust center</p>
      <h1 class="title-page mt-4 font-display font-bold tracking-[-.045em] text-white">{metadata.h1}</h1>
      <p class="mt-5 text-lg leading-8 text-sand-300">One creator-owned destination is confirmed in this registry. Group, Discord, and board links stay unlinked until an exact official URL is verified.</p>
    </div>

    <div class="mt-10 grid gap-4 lg:gap-5">
      {officialLinkRecords.map((record, index) => {
        const state = stateConfig[record.state];

        return (
          <article
            data-official-link-row
            class:list={[
              'min-w-0 rounded-2xl border bg-ink-900 p-5 sm:p-6',
              record.state === 'confirmed' ? 'border-leaf-500/35' : 'border-line',
            ]}
            aria-labelledby={`official-link-${record.id}`}
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="font-mono text-[10px] font-semibold uppercase tracking-[.14em] text-sand-300/70">Record 0{index + 1}</p>
                <h2 id={`official-link-${record.id}`} class="mt-2 font-display text-xl font-bold text-white">{record.label}</h2>
              </div>
              <span class:list={['inline-flex items-center rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[.12em]', state.classes]}>
                {state.label}
              </span>
            </div>

            <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-[minmax(0,10rem)_1fr]">
              <div>
                <dt class="font-mono text-[10px] uppercase tracking-[.12em] text-sand-300/70">Checked</dt>
                <dd class="mt-2 text-sand-200"><time datetime={record.checkedAt}>{record.checkedAt}</time></dd>
              </div>
              <div class="min-w-0">
                <dt class="font-mono text-[10px] uppercase tracking-[.12em] text-sand-300/70">Source</dt>
                <dd class="mt-2 break-words text-sand-200">{record.source.name}</dd>
              </div>
              <div class="sm:col-span-2">
                <dt class="font-mono text-[10px] uppercase tracking-[.12em] text-sand-300/70">Safety note</dt>
                <dd class="mt-2 text-sm leading-6 text-sand-300">{record.safetyNote}</dd>
              </div>
            </dl>

            <div class="mt-5 border-t border-line pt-4">
              {record.url ? (
                <a
                  data-official-link-action
                  href={record.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-leaf-500/35 px-4 py-2 text-sm font-bold text-leaf-400 no-underline hover:border-leaf-500/60 hover:text-leaf-300"
                >
                  Open official Roblox page
                </a>
              ) : (
                <p data-official-link-status-note class="min-h-[44px] rounded-md border border-dashed border-line px-4 py-3 text-sm leading-5 text-sand-300">
                  {state.note}
                </p>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
