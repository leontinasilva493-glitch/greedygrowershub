---
import type { RelatedNextStep } from '../data/related';

interface Props {
  items: RelatedNextStep[];
  title?: string;
}

const { items, title = 'Useful next steps' } = Astro.props;
---

<aside class="mt-12 border-y border-line py-7" aria-labelledby="related-next-steps-title">
  <p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-leaf-400">Continue with a reason</p>
  <h2 id="related-next-steps-title" class="mt-2 font-display text-2xl font-bold text-white">{title}</h2>
  <nav class="mt-5 grid divide-y divide-line border-y border-line md:grid-cols-3 md:divide-x md:divide-y-0" aria-label={title}>
    {items.map((item) => (
      <a href={item.href} class="group min-h-32 px-1 py-5 no-underline md:px-5 md:first:pl-0 md:last:pr-0">
        <strong class="text-white group-hover:text-leaf-300">{item.label} →</strong>
        <span class="mt-2 block text-sm leading-6 text-sand-300">{item.reason}</span>
      </a>
    ))}
  </nav>
</aside>
