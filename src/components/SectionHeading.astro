---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  <p class="font-mono text-[11px] font-bold uppercase tracking-[.22em] text-leaf-400">{eyebrow}</p>
  <h2 class="mt-3 font-display text-3xl font-bold leading-[1.05] tracking-[-.035em] text-white sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-7 text-sand-300">{description}</p>}
</div>
