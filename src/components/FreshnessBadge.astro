---
import Icon from './Icon.astro';
import type { FreshnessState } from '../lib/freshness';

interface Props {
  state: FreshnessState;
  label?: string;
}

const { state, label } = Astro.props;
const config = {
  confirmed: {
    text: 'Confirmed',
    classes: 'border-leaf-500/35 bg-leaf-500/10 text-leaf-400',
    icon: 'check',
  },
  reported: {
    text: 'Third-party reported',
    classes: 'border-sky-400/35 bg-sky-400/10 text-sky-300',
    icon: 'source',
  },
  conflict: {
    text: 'Conflict',
    classes: 'border-amber-400/35 bg-amber-400/10 text-amber-300',
    icon: 'warning',
  },
  'needs-check': {
    text: 'Needs check',
    classes: 'border-sand-300/25 bg-white/5 text-sand-300',
    icon: 'warning',
  },
} as const;
const item = config[state];
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[.12em]', item.classes]}>
  <Icon name={item.icon} size={12} /> {label ?? item.text}
</span>
