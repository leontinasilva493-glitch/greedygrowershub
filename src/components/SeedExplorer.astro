---
import type { SeedRecord } from '../lib/content';
import { getSource } from '../lib/content';
import StatusBadge from './StatusBadge.astro';

interface Props { items: SeedRecord[] }
const { items } = Astro.props;
const rarities = [...new Set(items.map((seed) => seed.rarity))];
const formatSpawnChance = (value: number | null) => value === null ? 'Not reported' : `1 in ${new Intl.NumberFormat('en-US').format(value)}`;
---

<section data-seed-explorer>
  <div class="grid gap-4 rounded-2xl border border-line bg-ink-900 p-5 sm:grid-cols-2 lg:grid-cols-4">
    <label class="grid gap-2 text-sm font-medium">Search seeds
      <input class="rounded-xl border border-line bg-ink-950 px-4 py-3" type="search" placeholder="Try Void or Mango" autocomplete="off" data-seed-search />
    </label>
    <label class="grid gap-2 text-sm font-medium">Rarity
      <select class="rounded-xl border border-line bg-ink-950 px-4 py-3" data-seed-filter="rarity">
        <option value="all">All rarities</option>
        {rarities.map((rarity) => <option value={rarity}>{rarity}</option>)}
      </select>
    </label>
    <label class="grid gap-2 text-sm font-medium">Verification
      <select class="rounded-xl border border-line bg-ink-950 px-4 py-3" data-seed-filter="verification">
        <option value="all">All records</option>
        <option value="community-lead">Matched public reports</option>
        <option value="verified">Gameplay verified</option>
        <option value="needs-check">Needs check</option>
      </select>
    </label>
    <label class="grid gap-2 text-sm font-medium">Sort
      <select class="rounded-xl border border-line bg-ink-950 px-4 py-3" data-seed-sort>
        <option value="name:asc">Name A–Z</option>
        <option value="costSortValue:asc">Reported price: low first</option>
        <option value="costSortValue:desc">Reported price: high first</option>
        <option value="spawnOneIn:asc">Spawn chance: more common</option>
        <option value="spawnOneIn:desc">Spawn chance: rarer</option>
      </select>
    </label>
  </div>

  <p class="mt-4 text-sm text-sand-300"><span class="font-semibold text-sand-100" data-seed-result-count>{items.length}</span> seeds shown. Prices and spawn denominators below are matching third-party reports for Update 1.2, not official drop-rate confirmation.</p>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-ink-900/70 p-3">
    <p class="text-xs leading-5 text-sand-300">Filters and up to two selected seeds can be saved in one review link.</p>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="min-h-11 rounded-lg border border-line bg-ink-950 px-4 text-sm font-semibold text-white hover:border-leaf-500/50" data-copy-seed-view>Copy current view</button>
      <span class="min-w-24 text-xs text-leaf-300" role="status" aria-live="polite" data-seed-share-status></span>
    </div>
  </div>

  <aside class="sticky top-16 z-30 mt-4 hidden items-center justify-between gap-3 rounded-xl border border-leaf-500/35 bg-ink-950/95 p-3 shadow-xl backdrop-blur" data-compare-tray aria-label="Selected seed comparison">
    <p class="text-sm"><strong class="text-white" data-compare-count>0 selected</strong><span class="ml-2 text-sand-300">Comparison stays available while you browse.</span></p>
    <div class="flex shrink-0 gap-2">
      <button type="button" class="min-h-11 rounded-lg px-3 text-sm font-semibold text-sand-200 hover:text-white" data-clear-comparison>Clear</button>
      <a href="#comparison" class="inline-flex min-h-11 items-center rounded-lg bg-leaf-500 px-4 text-sm font-bold text-ink-950 no-underline">Compare</a>
    </div>
  </aside>

  <div class="mt-5 hidden overflow-x-auto rounded-2xl border border-line md:block">
    <table class="w-full border-collapse text-left text-sm">
      <thead class="bg-ink-900 font-mono text-[11px] uppercase tracking-[.12em] text-sand-300">
        <tr><th class="px-4 py-4">Compare</th><th class="px-4 py-4">Seed</th><th class="px-4 py-4">Rarity</th><th class="px-4 py-4">Reported price</th><th class="px-4 py-4">Spawn chance</th><th class="px-4 py-4">Version</th><th class="px-4 py-4">Evidence</th></tr>
      </thead>
      <tbody data-seed-list>
        {items.map((seed) => (
          <tr class="border-t border-line bg-ink-950/40" data-seed-item data-id={seed.id} data-name={seed.name} data-rarity={seed.rarity} data-verification={seed.verification} data-cost-sort-value={seed.costSortValue ?? ''} data-spawn-one-in={seed.spawnOneIn ?? ''}>
            <td class="px-4 py-2"><label class="grid size-11 cursor-pointer place-items-center rounded-lg hover:bg-white/5"><input class="size-4 accent-leaf-500" type="checkbox" value={seed.id} data-seed-compare aria-label={`Compare ${seed.name}`} /></label></td>
            <td class="px-4 py-4"><strong>{seed.name}</strong><p class="mt-1 text-xs text-sand-300">{seed.availability}</p></td>
            <td class="px-4 py-4 font-semibold text-leaf-400">{seed.rarity}</td>
            <td class="px-4 py-4 font-mono">{seed.costDisplay}</td>
            <td class="px-4 py-4">{formatSpawnChance(seed.spawnOneIn)}</td>
            <td class="px-4 py-4">{seed.gameVersionClaim}</td>
            <td class="px-4 py-4"><StatusBadge state={seed.verification} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mt-5 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-ink-900 md:hidden" data-seed-list>
    {items.map((seed) => (
      <details class="group bg-ink-900 open:bg-ink-950/45" data-seed-item data-id={seed.id} data-name={seed.name} data-rarity={seed.rarity} data-verification={seed.verification} data-cost-sort-value={seed.costSortValue ?? ''} data-spawn-one-in={seed.spawnOneIn ?? ''}>
        <summary class="grid min-h-16 cursor-pointer list-none grid-cols-[1fr_auto_auto] items-center gap-3 px-4 py-3">
          <span class="min-w-0"><strong class="block truncate text-white">{seed.name}</strong><span class="mt-1 block text-xs text-sand-300">{seed.rarity} · {seed.gameVersionClaim}</span></span>
          <span class="text-right"><span class="block font-mono text-sm text-white">{seed.costDisplay}</span><span class="mt-1 block text-[11px] text-sand-300">reported price</span></span>
          <span class="grid size-8 place-items-center rounded-full border border-line text-leaf-400 transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <div class="border-t border-line px-4 pb-4 pt-3">
          <div class="flex justify-end"><StatusBadge state={seed.verification} /></div>
          <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
            <div><dt class="text-xs text-sand-300">Spawn chance</dt><dd class="mt-1">{formatSpawnChance(seed.spawnOneIn)}</dd></div>
            <div><dt class="text-xs text-sand-300">Availability</dt><dd class="mt-1">{seed.availability}</dd></div>
          </dl>
          <label class="mt-4 flex min-h-11 cursor-pointer items-center gap-3 rounded-xl border border-line px-3 text-sm font-semibold text-white"><input class="size-4 accent-leaf-500" type="checkbox" value={seed.id} data-seed-compare /> Add to comparison</label>
        </div>
      </details>
    ))}
  </div>

  <p class="mt-5 hidden rounded-xl border border-line bg-ink-900 p-5 text-sm text-sand-300" data-seed-empty>No seeds match these filters.</p>

  <section id="comparison" class="mt-10 scroll-mt-36 rounded-3xl border border-leaf-500/25 bg-leaf-500/[.045] p-5 sm:p-7" aria-labelledby="comparison-title">
    <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="font-mono text-xs uppercase tracking-[.16em] text-leaf-400">Side by side</p><h2 id="comparison-title" class="mt-2 text-2xl font-semibold">Compare Two Greedy Growers Seeds</h2></div><p class="text-sm text-sand-300" data-compare-count>0 selected</p></div>
    <div class="mt-5 grid gap-4 sm:grid-cols-2" data-compare-list>
      <p class="text-sm text-sand-300" data-compare-placeholder>Select records above. Unknown values stay unknown.</p>
      {items.map((seed) => (
        <article class="hidden rounded-2xl border border-line bg-ink-950/70 p-5" data-compare-card={seed.id}>
          <h3 class="text-lg font-semibold">{seed.name}</h3>
          <dl class="mt-4 grid gap-2 text-sm">
            <div class="flex justify-between gap-4"><dt class="text-sand-300">Rarity</dt><dd>{seed.rarity}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-sand-300">Reported price</dt><dd class="font-mono">{seed.costDisplay}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-sand-300">Spawn chance</dt><dd>{formatSpawnChance(seed.spawnOneIn)}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-sand-300">Version</dt><dd>{seed.gameVersionClaim}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-sand-300">Availability</dt><dd class="text-right">{seed.availability}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-sand-300">Sources</dt><dd class="text-right">{seed.sourceIds.map((id) => getSource(id).name).join(' + ')}</dd></div>
          </dl>
          <p class="mt-4 border-t border-line pt-4 text-xs text-sand-300">Harvest value, growth time, and profit rate remain unranked until they can be checked in the current game.</p>
        </article>
      ))}
    </div>
  </section>
</section>

<script>import '../scripts/seeds';</script>
