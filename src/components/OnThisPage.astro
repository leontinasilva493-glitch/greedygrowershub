---
interface Props {
  items: Array<{ label: string; href: string }>;
}

const { items } = Astro.props;
---

<nav class="mt-8 rounded-2xl border border-line bg-ink-900/70 p-3 sm:p-4" aria-label="On this page">
  <div class="flex items-center gap-3 overflow-x-auto pb-1 [scrollbar-width:thin]">
    <span class="shrink-0 px-2 font-mono text-[10px] font-bold uppercase tracking-[.16em] text-leaf-400">On this page</span>
    {items.map((item) => (
      <a href={item.href} class="shrink-0 rounded-full border border-line bg-ink-950 px-3 py-2 text-xs font-semibold text-sand-100 no-underline transition hover:border-leaf-500/50 hover:text-leaf-300">{item.label}</a>
    ))}
  </div>
</nav>
