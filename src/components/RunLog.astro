<section
  class="rounded-3xl border border-line bg-ink-900/85 p-5 sm:p-7 lg:col-span-2"
  aria-labelledby="run-log-title"
  data-run-log
>
  <div class="max-w-3xl">
    <p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-amber-300">Your observations / not site facts</p>
    <h3 id="run-log-title" class="mt-3 font-display text-2xl font-bold text-white">Five-run observation log</h3>
    <p class="mt-3 text-sm leading-6 text-sand-300">
      Save the current calculator result with your own scenario label. This list stays in the page only, clears on reload,
      and never updates site data or presets.
    </p>
  </div>

  <div class="mt-6 grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <label class="grid gap-2 text-sm font-medium">
      Scenario label
      <input
        class="min-h-11 rounded-xl border border-line bg-ink-950 px-4 py-3 text-base text-sand-100"
        type="text"
        maxlength="80"
        placeholder="River corn after one lightning loss"
        autocomplete="off"
        data-run-log-label
      />
    </label>
    <button
      type="button"
      class="min-h-11 rounded-xl bg-leaf-500 px-5 py-3 text-sm font-bold text-ink-950 disabled:cursor-not-allowed disabled:bg-line disabled:text-sand-400"
      data-run-log-add
      disabled
    >
      Add current run
    </button>
  </div>

  <p class="mt-3 min-h-6 text-sm text-sand-300" data-run-log-feedback aria-live="polite"></p>
  <p class="min-h-6 text-sm text-amber-300" data-run-log-error aria-live="polite"></p>

  <div
    class="mt-5 hidden rounded-2xl border border-line bg-ink-950/65 p-4"
    data-run-log-summary
  >
    <div class="grid gap-3 sm:grid-cols-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-sand-300">Saved runs</p>
        <p class="mt-2 text-2xl font-semibold text-white" data-run-log-count></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-sand-300">Median net / minute</p>
        <p class="mt-2 text-2xl font-semibold text-leaf-400" data-run-log-median></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-sand-300">Range net / minute</p>
        <p class="mt-2 text-2xl font-semibold text-white" data-run-log-range></p>
      </div>
    </div>
  </div>

  <div class="mt-5 flex flex-wrap gap-3">
    <button
      type="button"
      class="min-h-11 rounded-xl border border-line px-5 py-3 text-sm font-bold text-white disabled:cursor-not-allowed disabled:text-sand-400"
      data-run-log-copy
      disabled
    >
      Copy plain-text
    </button>
    <button
      type="button"
      class="min-h-11 rounded-xl border border-line px-5 py-3 text-sm font-bold text-white disabled:cursor-not-allowed disabled:text-sand-400"
      data-run-log-clear
      disabled
    >
      Clear all
    </button>
  </div>

  <div class="mt-4 hidden rounded-2xl border border-amber-400/25 bg-amber-300/[.06] p-4" data-run-log-copy-fallback>
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="font-semibold text-amber-100">Clipboard blocked</p>
        <p class="mt-1 text-sm leading-6 text-amber-100/90">
          Select the text below and copy it manually. When you finish, hide this fallback or keep editing the log.
        </p>
      </div>
      <button
        type="button"
        class="min-h-11 rounded-xl border border-amber-300/40 px-4 py-3 text-sm font-bold text-amber-100"
        data-run-log-hide-fallback
      >
        Hide fallback
      </button>
    </div>
    <label class="mt-4 grid gap-2 text-sm font-medium text-amber-100">
      Plain-text summary
      <textarea
        class="min-h-40 rounded-xl border border-amber-300/35 bg-ink-950 px-4 py-3 font-mono text-sm text-sand-100"
        readonly
        data-run-log-copy-text
      ></textarea>
    </label>
  </div>

  <p class="mt-5 text-sm leading-6 text-sand-300" data-run-log-empty>
    No saved runs yet. Add a scenario label, then save up to five current calculator outcomes.
  </p>

  <ul class="mt-5 grid gap-3" data-run-log-list aria-label="Saved observation runs"></ul>

  <template data-run-log-item-template>
    <li class="rounded-2xl border border-line bg-ink-950/65 p-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-lg font-semibold break-words text-white" data-run-log-item-label></p>
          <p class="mt-1 text-sm text-sand-300" data-run-log-item-meta></p>
        </div>
        <button
          type="button"
          class="min-h-11 rounded-xl border border-line px-4 py-3 text-sm font-bold text-white"
          data-run-log-remove
        >
          Remove
        </button>
      </div>

      <dl class="mt-4 grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-line bg-ink-900 p-3">
          <dt class="text-xs font-semibold uppercase tracking-[.16em] text-sand-300">Net after failures</dt>
          <dd class="mt-2 text-lg font-semibold text-white" data-run-log-item-profit></dd>
        </div>
        <div class="rounded-xl border border-line bg-ink-900 p-3">
          <dt class="text-xs font-semibold uppercase tracking-[.16em] text-sand-300">Net / minute</dt>
          <dd class="mt-2 text-lg font-semibold text-white" data-run-log-item-rate></dd>
        </div>
        <div class="rounded-xl border border-line bg-ink-900 p-3">
          <dt class="text-xs font-semibold uppercase tracking-[.16em] text-sand-300">Elapsed minutes</dt>
          <dd class="mt-2 text-lg font-semibold text-white" data-run-log-item-minutes></dd>
        </div>
      </dl>
    </li>
  </template>
</section>
