---
import StatusBadge from './StatusBadge.astro';
import { rebirths } from '../lib/content';
---

<section class="rounded-2xl border border-line bg-ink-900 p-5 sm:p-6" data-rebirth-checklist>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="font-mono text-[10px] font-bold uppercase tracking-[.16em] text-amber-300">Local planning checklist</p>
      <h3 class="mt-2 font-display text-2xl font-bold text-white">Rebirth evidence checklist</h3>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-sand-300">Mark only the levels you personally checked. Progress stays in this browser and does not verify the community-reported requirements or perks.</p>
    </div>
    <StatusBadge state="community-lead" label="Community-reported data" />
  </div>
  <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {rebirths.map((rebirth) => (
      <label class="flex cursor-pointer gap-3 rounded-xl border border-line bg-ink-950/55 p-4 transition has-[:checked]:border-leaf-500/45 has-[:checked]:bg-leaf-500/[.055]">
        <input class="mt-1 size-5 shrink-0 accent-leaf-500" type="checkbox" value={rebirth.level} data-rebirth-level />
        <span>
          <strong class="block text-white">Rebirth {rebirth.level}</strong>
          <span class="mt-1 block text-xs leading-5 text-sand-300">{rebirth.requirement}</span>
        </span>
      </label>
    ))}
  </div>
  <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-line pt-5">
    <button type="button" class="min-h-11 rounded-lg border border-line px-4 text-sm font-bold text-sand-100" data-rebirth-reset>Reset checklist</button>
    <p class="text-xs text-leaf-300" data-rebirth-status role="status" aria-live="polite">Nothing marked yet.</p>
  </div>
</section>

<script>import '../scripts/rebirth-checklist';</script>
