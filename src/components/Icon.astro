---
interface Props {
  name: 'sprout' | 'ticket' | 'calculator' | 'book' | 'external' | 'shield' | 'clock' | 'bolt' | 'menu' | 'check' | 'warning' | 'source';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'sprout' && <><path d="M12 22V12"/><path d="M7 13c-3.5 0-5-2.5-5-7 4.5 0 7 1.5 7 5"/><path d="M15 11c0-4 2.5-6 7-6 0 4.5-2 7-6 7"/></>}
  {name === 'ticket' && <><path d="M3 8a2 2 0 0 0 0 4v4h18v-4a2 2 0 0 0 0-4V4H3z"/><path d="M9 8h.01M9 12h.01"/></>}
  {name === 'calculator' && <><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8v3H8zM8 13h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01M16 17h.01"/></>}
  {name === 'book' && <><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M4 4v15.5A2.5 2.5 0 0 0 6.5 22H20V4z"/></>}
  {name === 'external' && <><path d="M15 3h6v6M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></>}
  {name === 'shield' && <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
  {name === 'bolt' && <path d="m13 2-9 12h8l-1 8 9-12h-8z"/>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16"/>}
  {name === 'check' && <path d="m5 12 4 4L19 6"/>}
  {name === 'warning' && <><path d="m12 3 10 18H2z"/><path d="M12 9v4M12 17h.01"/></>}
  {name === 'source' && <><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></>}
</svg>
