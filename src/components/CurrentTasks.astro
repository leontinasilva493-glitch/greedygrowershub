---
import FreshnessBadge from './FreshnessBadge.astro';
import { getFreshness } from '../lib/freshness';

const cards = [
  {
    title: 'Codes',
    href: '/codes/',
    action: 'Check code status',
    record: getFreshness('codes'),
  },
  {
    title: 'Seeds',
    href: '/seeds/list/',
    action: 'Compare seed records',
    record: getFreshness('seeds'),
  },
  {
    title: 'Mutations',
    href: '/mechanics/mutations/',
    action: 'Review mutation evidence',
    record: getFreshness('mutations'),
  },
  {
    title: 'Beginner',
    href: '/beginner-guide/',
    action: 'Follow the first harvest route',
    record: {
      state: 'confirmed',
      summary: 'Use the official Roblox listing, buy one seed at the river, plant it in your plot, and finish one first harvest before changing the plan.',
      nextCheck: 'Complete one clean first harvest, then move to seeds or harvest timing with your own notes.',
      checkedAt: getFreshness('roblox-listing').checkedAt,
    },
  },
] as const;
---

<section class="border-b border-line bg-ink-950/55" aria-labelledby="current-tasks-title" data-current-tasks>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <div class="max-w-3xl">
      <p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-leaf-400">Current tasks</p>
      <h2 id="current-tasks-title" class="mt-3 font-display text-2xl font-bold text-white sm:text-3xl">Open the next page that matches what you need now</h2>
      <p class="mt-3 text-sm leading-6 text-sand-300">Keep the calculator as the main tool, then jump straight to the freshest answer or the safest beginner route.</p>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {cards.map((card) => (
        <article class="flex min-w-0 flex-col rounded-2xl border border-line bg-ink-900 p-5" data-current-task-card>
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-mono text-[10px] font-semibold uppercase tracking-[.16em] text-sand-300">Current answer</p>
              <h3 class="mt-2 font-display text-xl font-bold text-white">{card.title}</h3>
            </div>
            <FreshnessBadge state={card.record.state} label={card.title === 'Beginner' ? 'Official loop' : undefined} />
          </div>

          <p class="mt-4 text-sm leading-6 text-sand-300">{card.record.summary}</p>
          <p class="mt-4 text-sm leading-6 text-sand-200"><span class="font-semibold text-white">Next:</span> {card.record.nextCheck}</p>

          <a
            href={card.href}
            class="mt-auto inline-flex min-h-11 items-center justify-between gap-3 pt-5 font-bold text-leaf-400 no-underline"
            data-current-task-action
          >
            <span>{card.action}</span>
            <span aria-hidden="true" class="shrink-0">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
