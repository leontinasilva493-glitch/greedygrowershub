---
import Icon from './Icon.astro';
import { fertilizers, getSource, seeds } from '../lib/content';
import { buildCalculatorContext, getMutationPreset, mutationPresets } from '../lib/calculator-context';

const fertilizerSource = getSource('greedygrowers-codes');
const initialContext = buildCalculatorContext(null, getMutationPreset('base'));
---

<section class="grid gap-5 lg:grid-cols-[.92fr_1.08fr]" aria-labelledby="calculator-title">
  <form class="rounded-3xl border border-line bg-ink-900 p-5 sm:p-7" data-calculator>
    <div class="mb-6 flex items-center gap-3">
      <span class="grid size-10 place-items-center rounded-xl bg-leaf-500 text-ink-950"><Icon name="calculator" /></span>
      <div class="min-w-0">
        <h2 id="calculator-title" class="text-xl font-semibold">Profit and Failed-Run Risk Calculator</h2>
        <p class="text-sm text-sand-300">Choose a current seed label, then enter the cost and result you observed in game.</p>
      </div>
    </div>

    <aside class="mb-6 overflow-hidden rounded-2xl border border-leaf-500/25 bg-leaf-500/[.045]" data-calculator-context aria-label="Selected calculator context" aria-live="polite">
      <div class="border-b border-leaf-500/15 px-4 py-3">
        <p class="font-mono text-[10px] font-bold uppercase tracking-[.16em] text-leaf-400">20 Seeds + 6 Mutations context</p>
      </div>
      <dl class="grid grid-cols-2 gap-px bg-line text-xs sm:grid-cols-4">
        <div class="bg-ink-950/85 p-3"><dt class="text-sand-300">Selected</dt><dd class="mt-1 font-semibold text-white" data-context="selectedSeed">{initialContext.selectedSeed}</dd></div>
        <div class="bg-ink-950/85 p-3"><dt class="text-sand-300">Reported cost</dt><dd class="mt-1 font-semibold text-white" data-context="reportedCost">{initialContext.reportedCost}</dd></div>
        <div class="bg-ink-950/85 p-3"><dt class="text-sand-300">Rarity</dt><dd class="mt-1 font-semibold text-white" data-context="rarity">{initialContext.rarity}</dd></div>
        <div class="bg-ink-950/85 p-3"><dt class="text-sand-300">River spawn</dt><dd class="mt-1 font-semibold text-white" data-context="riverSpawn">{initialContext.riverSpawn}</dd></div>
        <div class="col-span-2 bg-ink-950/85 p-3 sm:col-span-2"><dt class="text-sand-300">Mutation preset</dt><dd class="mt-1 font-semibold text-leaf-400" data-context="mutationPreset">{initialContext.mutationPreset}</dd></div>
        <div class="col-span-2 bg-ink-950/85 p-3 sm:col-span-2"><dt class="text-sand-300">Evidence</dt><dd class="mt-1 font-semibold text-amber-200" data-context="evidence">{initialContext.evidence}</dd></div>
      </dl>
    </aside>

    <fieldset>
      <legend class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-leaf-400">Quick setup</legend>
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        <label class="grid gap-2 text-sm font-medium">
          Seed reference
          <select class="rounded-xl border border-leaf-500/30 bg-ink-950 px-4 py-3 text-base text-sand-100" name="seedPreset" data-seed-preset>
            <option value="">Manual values</option>
            {seeds.map((seed) => (
              <option
                value={seed.id}
                data-seed-name={seed.name}
                data-cost-display={seed.costDisplay}
                data-rarity={seed.rarity}
                data-spawn-one-in={seed.spawnOneIn ?? ''}
              >{seed.name} · {seed.rarity}</option>
            ))}
          </select>
        </label>
        <label class="grid gap-2 text-sm font-medium">
          Fertilizer preset
          <select class="rounded-xl border border-leaf-500/30 bg-ink-950 px-4 py-3 text-base text-sand-100" name="fertilizerPreset" data-fertilizer-preset>
            <option value="" data-cost="0" data-multiplier="1">None · x1</option>
            {fertilizers.map((fertilizer) => (
              <option value={fertilizer.id} data-cost={fertilizer.cost} data-multiplier={fertilizer.boostMultiplier}>
                {fertilizer.name} · x{fertilizer.boostMultiplier}
              </option>
            ))}
          </select>
        </label>
        <label class="grid gap-2 text-sm font-medium sm:col-span-2">
          Failed runs before the next success
          <span class="grid grid-cols-[1fr_auto] items-center gap-3">
            <input class="min-w-0 rounded-xl border border-line bg-ink-950 px-4 py-3 text-base text-sand-100" name="failedRuns" type="number" min="0" step="1" value="0" inputmode="numeric" required />
            <span class="max-w-44 text-xs leading-5 text-sand-300">Count attempts already lost to lightning or another failed harvest.</span>
          </span>
        </label>
      </div>
    </fieldset>

    <details class="group mt-5 rounded-2xl border border-line bg-ink-950/45" data-advanced-inputs>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-4 font-semibold text-white marker:content-none">
        <span><span class="block">Enter calculator inputs</span><span class="mt-1 block text-xs font-normal text-sand-300">Use values from your own run; current seed economics are intentionally not auto-filled.</span></span>
        <span class="grid size-8 place-items-center rounded-lg border border-line text-leaf-400 transition group-open:rotate-45">+</span>
      </summary>
      <div class="grid gap-4 border-t border-line p-4 sm:grid-cols-2">
        <label class="grid gap-2 text-sm font-medium">
          Seed cost
          <input class="rounded-xl border border-line bg-ink-950 px-4 py-3 text-base text-sand-100" name="seedCost" type="number" min="0" step="any" value="100" inputmode="decimal" required />
        </label>
        <label class="grid gap-2 text-sm font-medium">
          Harvest value
          <input class="rounded-xl border border-line bg-ink-950 px-4 py-3 text-base text-sand-100" name="harvestValue" type="number" min="0" step="any" value="160" inputmode="decimal" required />
        </label>
        <label class="grid gap-2 text-sm font-medium">
          Wait time (minutes)
          <input class="rounded-xl border border-line bg-ink-950 px-4 py-3 text-base text-sand-100" name="waitMinutes" type="number" min="0.01" step="any" value="3" inputmode="decimal" required />
        </label>
        <label class="grid gap-2 text-sm font-medium">
          Fertilizer cost
          <input class="rounded-xl border border-line bg-ink-950 px-4 py-3 text-base text-sand-100" name="fertilizerCost" type="number" min="0" step="any" value="0" inputmode="decimal" required />
        </label>
        <div class="grid gap-3 sm:col-span-2">
          <label class="grid gap-2 text-sm font-medium">
            Harvest multiplier
            <input class="rounded-xl border border-line bg-ink-950 px-4 py-3 text-base text-sand-100" name="harvestMultiplier" type="number" min="1" step="any" value="1" inputmode="decimal" required />
          </label>
          <fieldset class="rounded-2xl border border-leaf-500/20 bg-leaf-500/[.035] p-4">
            <legend class="px-1 font-mono text-[10px] font-bold uppercase tracking-[.16em] text-leaf-400">Update 1.2 matched community report</legend>
            <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4" data-mutation-presets>
              {mutationPresets.map((preset) => (
                <button
                  type="button"
                  class="rounded-xl border border-line bg-ink-950 px-3 py-2.5 text-left text-xs text-sand-300 transition hover:border-leaf-500/50 hover:text-white data-[state=active]:border-leaf-500 data-[state=active]:bg-leaf-500/10 data-[state=active]:text-white"
                  data-mutation-preset={preset.id}
                  data-state={preset.id === 'base' ? 'active' : 'idle'}
                  aria-pressed={preset.id === 'base' ? 'true' : 'false'}
                ><strong class="block font-mono text-sm text-leaf-400">{preset.multiplier}x</strong>{preset.name}</button>
              ))}
            </div>
            <p class="mt-3 text-xs leading-5 text-sand-300">A preset only replaces the multiplier input. It does not calculate mutation chance or combine multiple mutations. <a href="/mechanics/mutations/" class="font-semibold text-leaf-400">Read the evidence guide →</a></p>
          </fieldset>
        </div>
      </div>
    </details>

    <p class="mt-4 min-h-6 text-sm text-amber-300" data-calculator-error aria-live="polite"></p>
    <p class="rounded-xl border border-amber-400/25 bg-amber-300/[.06] p-4 text-xs leading-5 text-amber-100">
      Seed names follow the source-matched Update 1.2 catalog checked {seeds[0]?.verifiedAt}, but selecting one does not fill unverified harvest economics. Fertilizer presets remain a legacy community snapshot from <a class="font-semibold underline" href={fertilizerSource.url} target="_blank" rel="noopener noreferrer">{fertilizerSource.name}</a> and still need an in-game recheck.
    </p>
  </form>

  <div
    class="group rounded-3xl border p-5 transition-colors data-[state=break-even]:border-amber-400/35 data-[state=break-even]:bg-amber-300/[.06] data-[state=loss]:border-rose-400/35 data-[state=loss]:bg-rose-400/[.055] data-[state=profitable]:border-leaf-500/35 data-[state=profitable]:bg-leaf-500/[.055] sm:p-7"
    data-calculator-result
    data-state="profitable"
    aria-live="polite"
  >
    <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-leaf-400 group-data-[state=break-even]:text-amber-300 group-data-[state=loss]:text-rose-300">Decision after recorded losses</p>
    <div class="mt-5 rounded-2xl border border-white/10 bg-ink-950/60 p-5 sm:p-6">
      <p class="font-display text-2xl font-bold text-white sm:text-3xl" data-decision-headline>Recorded losses are covered</p>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-sand-300" data-decision-explanation>This result stays profitable after the failed attempts you entered.</p>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
        <div><p class="text-sm text-sand-300">Risk-adjusted profit</p><p class="mt-1 font-display text-4xl font-bold text-leaf-400 group-data-[state=break-even]:text-amber-300 group-data-[state=loss]:text-rose-300" data-output="riskAdjustedProfit">60</p></div>
        <div class="text-right"><p class="text-sm text-sand-300">Adjusted profit / minute</p><p class="mt-1 font-mono text-2xl font-semibold text-white" data-output="riskAdjustedProfitPerMinute">20</p></div>
      </div>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <div class="rounded-2xl border border-line bg-ink-950/70 p-4 sm:col-span-2">
        <p class="text-sm text-sand-300">Break-even harvest after failed runs</p>
        <p class="mt-2 text-2xl font-semibold" data-output="breakEvenHarvest">100</p>
      </div>
      <div class="rounded-2xl border border-line bg-ink-950/70 p-4">
        <p class="text-sm text-sand-300">Cost per attempt</p>
        <p class="mt-2 text-xl font-semibold" data-output="totalInvestment">100</p>
      </div>
      <div class="rounded-2xl border border-line bg-ink-950/70 p-4">
        <p class="text-sm text-sand-300">Boosted harvest value</p>
        <p class="mt-2 text-xl font-semibold" data-output="boostedHarvestValue">160</p>
      </div>
      <div class="rounded-2xl border border-line bg-ink-950/70 p-4">
        <p class="text-sm text-sand-300">Profit per successful run</p>
        <p class="mt-2 text-xl font-semibold" data-output="profitPerSuccess">60</p>
      </div>
      <div class="rounded-2xl border border-line bg-ink-950/70 p-4">
        <p class="text-sm text-sand-300">Successful-run profit / minute</p>
        <p class="mt-2 text-xl font-semibold" data-output="profitPerMinute">20</p>
      </div>
    </div>
    <p class="mt-5 text-xs leading-5 text-sand-300">This browser-only planning tool records losses you enter. It does not read your Roblox account, know hidden lightning odds, or predict the next strike.</p>
  </div>
</section>

<script>import '../scripts/calculator';</script>
