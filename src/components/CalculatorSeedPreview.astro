---
import StatusBadge from './StatusBadge.astro';
import { seeds, site } from '../lib/content';
import { getReportedSeedPreview } from '../lib/calculator-seeds';

const preview = getReportedSeedPreview(seeds);
const formatSpawnChance = (value: number | null) => value === null ? 'Not reported' : `1 in ${value.toLocaleString('en-US')}`;
---

<aside class="mt-8 overflow-hidden rounded-3xl border border-line bg-ink-900/70" aria-labelledby="reported-seed-preview-title">
  <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line px-5 py-6 sm:px-7">
    <div>
      <p class="font-mono text-[10px] font-bold uppercase tracking-[.18em] text-amber-300">Current reported catalog</p>
      <h3 id="reported-seed-preview-title" class="mt-2 font-display text-2xl font-bold text-white">Check lower-cost seeds before entering your own run</h3>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-sand-300">These are the five lowest reported buy-ins in the Update 1.2 catalog. They are a shop reference—not profit presets—because current harvest values and growth times still need gameplay verification.</p>
    </div>
    <a href="/seeds/list/" data-event="calculator_continue_click" data-event-label="seed-list" class="text-sm font-bold text-leaf-400 no-underline hover:text-leaf-300">Open all 20 seeds →</a>
  </div>

  <div class="hidden overflow-x-auto md:block">
    <table class="w-full text-left text-sm">
      <caption class="sr-only">Five Greedy Growers seeds ordered by reported shop price</caption>
      <thead class="bg-ink-950/55 font-mono text-[10px] uppercase tracking-[.12em] text-sand-300"><tr><th class="px-5 py-4">Seed</th><th class="px-5 py-4">Rarity</th><th class="px-5 py-4">Reported price</th><th class="px-5 py-4">Spawn chance</th><th class="px-5 py-4">Version</th><th class="px-5 py-4">Evidence</th></tr></thead>
      <tbody>{preview.map((seed) => <tr class="border-t border-line/80 bg-ink-900/35"><td class="px-5 py-4 font-bold text-white">{seed.name}</td><td class="px-5 py-4">{seed.rarity}</td><td class="px-5 py-4 font-mono">{seed.costDisplay}</td><td class="px-5 py-4">{formatSpawnChance(seed.spawnOneIn)}</td><td class="px-5 py-4">{seed.gameVersionClaim}</td><td class="px-5 py-4"><StatusBadge state={seed.verification} /></td></tr>)}</tbody>
    </table>
  </div>

  <div class="grid gap-3 p-4 md:hidden">
    {preview.map((seed) => <article class="rounded-2xl border border-line bg-ink-950/55 p-4"><div class="flex items-start justify-between gap-3"><div><h4 class="font-bold text-white">{seed.name}</h4><p class="mt-1 font-mono text-[10px] uppercase tracking-[.12em] text-sand-300">{seed.rarity} · {seed.gameVersionClaim}</p></div><StatusBadge state={seed.verification} /></div><dl class="mt-4 grid grid-cols-2 gap-2 text-xs"><div><dt class="text-sand-300">Reported price</dt><dd class="mt-1 font-semibold text-white">{seed.costDisplay}</dd></div><div><dt class="text-sand-300">Spawn chance</dt><dd class="mt-1 font-semibold text-leaf-400">{formatSpawnChance(seed.spawnOneIn)}</dd></div></dl></article>)}
  </div>

  <p class="border-t border-line px-5 py-4 text-xs leading-5 text-sand-300 sm:px-7">Catalog checked {site.checkedAt}. Type the cost, harvest result, wait time, and failed-run count you actually observed into the calculator.</p>
</aside>
