---
import Icon from './Icon.astro';
import { site } from '../lib/content';

const nav = [
  { label: 'Codes', href: '/codes/' },
  { label: 'New Player', href: '/beginner-guide/' },
  { label: 'Seeds', href: '/seeds/' },
  { label: 'Calculator', href: '/calculator/' },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-ink-950/92 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-5 px-4 sm:px-6 lg:px-8">
    <a href="/" class="group flex items-center gap-2.5 no-underline" aria-label={`${site.name} home`}>
      <span class="grid size-9 place-items-center rounded-lg border border-leaf-500/40 bg-leaf-500/10 text-leaf-400 shadow-[0_0_24px_rgba(101,229,114,.12)]">
        <Icon name="sprout" size={21} />
      </span>
      <span class="leading-none">
        <strong class="block font-display text-[15px] tracking-tight text-white">Greedy Growers</strong>
        <span class="mt-1 block font-mono text-[9px] uppercase tracking-[.22em] text-leaf-400">Player tools</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-medium no-underline transition-colors',
            currentPath === item.href ? 'bg-leaf-500/10 text-leaf-400' : 'text-sand-300 hover:bg-white/5 hover:text-white',
          ]}
        >{item.label}</a>
      ))}
    </nav>

    <div class="hidden md:block">
      <a href={site.officialGameUrl} target="_blank" rel="noopener noreferrer" data-event="play_roblox_click" class="inline-flex items-center gap-2 rounded-md bg-leaf-500 px-4 py-2 text-sm font-bold text-ink-950 no-underline transition hover:bg-leaf-400">
        Play on Roblox <Icon name="external" size={15} />
      </a>
    </div>

    <details class="relative md:hidden">
      <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-md border border-line bg-ink-900 text-sand-100" aria-label="Open navigation">
        <Icon name="menu" size={21} />
      </summary>
      <div class="absolute right-0 mt-2 w-64 rounded-xl border border-line bg-ink-900 p-2 shadow-2xl">
        {nav.map((item) => <a href={item.href} class="block rounded-lg px-4 py-3 text-sm font-semibold text-sand-100 no-underline hover:bg-white/5">{item.label}</a>)}
        <a href={site.officialGameUrl} target="_blank" rel="noopener noreferrer" data-event="play_roblox_click" class="mt-2 flex items-center justify-between rounded-lg bg-leaf-500 px-4 py-3 text-sm font-bold text-ink-950 no-underline">Play on Roblox <Icon name="external" size={15} /></a>
      </div>
    </details>
  </div>
</header>
