---
import Icon from './Icon.astro';

interface Props {
  state: 'verified' | 'community-lead' | 'needs-check' | 'official' | 'reported' | 'community';
  label?: string;
}

const { state, label } = Astro.props;
const config = {
  verified: { text: 'Verified', classes: 'border-leaf-500/35 bg-leaf-500/10 text-leaf-400', icon: 'check' },
  official: { text: 'Official', classes: 'border-leaf-500/35 bg-leaf-500/10 text-leaf-400', icon: 'shield' },
  'community-lead': { text: 'Community lead', classes: 'border-amber-400/35 bg-amber-400/10 text-amber-300', icon: 'source' },
  reported: { text: 'Reported', classes: 'border-sky-400/35 bg-sky-400/10 text-sky-300', icon: 'source' },
  'needs-check': { text: 'Needs check', classes: 'border-sand-300/25 bg-white/5 text-sand-300', icon: 'warning' },
  community: { text: 'Community', classes: 'border-violet-400/30 bg-violet-400/10 text-violet-300', icon: 'source' },
} as const;
const item = config[state];
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[.12em]', item.classes]}>
  <Icon name={item.icon} size={12} /> {label ?? item.text}
</span>
