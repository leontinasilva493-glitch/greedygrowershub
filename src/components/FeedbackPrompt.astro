---
interface Props {
  path: string;
}

const { path } = Astro.props;
---

<aside class="mt-8 rounded-2xl border border-line bg-ink-900/70 p-4 sm:flex sm:items-center sm:justify-between sm:gap-5" data-feedback-prompt data-feedback-path={path} hidden>
  <div><p class="font-semibold text-white">Was this page useful for your next decision?</p><p class="mt-1 text-xs leading-5 text-sand-300">This private signal enters editorial review. No public counts or automatic rankings.</p></div>
  <div class="mt-3 flex flex-wrap items-center gap-2 sm:mt-0" data-feedback-controls>
    <button type="button" class="min-h-11 rounded-lg bg-leaf-500 px-4 text-sm font-bold text-ink-950" data-feedback-choice="helpful">Helpful</button>
    <button type="button" class="min-h-11 rounded-lg border border-line px-4 text-sm font-semibold text-white" data-feedback-choice="needs-work">Needs work</button>
  </div>
  <p class="mt-3 text-sm text-leaf-300 sm:mt-0" role="status" aria-live="polite" data-feedback-status></p>
</aside>

<script>import '../scripts/feedback';</script>
