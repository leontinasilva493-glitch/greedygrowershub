<form class="rounded-2xl border border-leaf-500/25 bg-leaf-500/[.045] p-5 sm:p-6" data-harvest-timer>
  <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
    <div>
      <p class="font-mono text-[10px] font-bold uppercase tracking-[.16em] text-leaf-400">Browser-only manual timer</p>
      <h3 class="mt-2 font-display text-2xl font-bold text-white">Time the target you choose</h3>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-sand-300">Enter a duration from your own test. This tool does not recommend a harvest second, read the game, or predict lightning.</p>
      <div class="mt-5 grid max-w-md grid-cols-2 gap-3">
        <label class="grid gap-2 text-sm font-semibold text-sand-100">
          Minutes
          <input class="min-h-11 rounded-xl border border-line bg-ink-950 px-4 py-3 text-base text-white" type="number" name="minutes" min="0" step="1" inputmode="numeric" placeholder="e.g. 3" aria-describedby="harvest-timer-help" />
        </label>
        <label class="grid gap-2 text-sm font-semibold text-sand-100">
          Seconds
          <input class="min-h-11 rounded-xl border border-line bg-ink-950 px-4 py-3 text-base text-white" type="number" name="seconds" min="0" max="59" step="1" inputmode="numeric" placeholder="0–59" aria-describedby="harvest-timer-help" />
        </label>
      </div>
      <p id="harvest-timer-help" class="mt-2 text-xs text-sand-300">No value is prefilled because the project has no verified universal target.</p>
    </div>
    <div class="min-w-52 rounded-2xl border border-line bg-ink-950/70 p-5 text-center">
      <p class="text-xs font-semibold text-sand-300">Time remaining</p>
      <output class="mt-2 block font-mono text-4xl font-bold tabular-nums text-white" data-timer-output aria-live="off">00:00</output>
      <p class="mt-2 min-h-5 text-xs text-leaf-300" data-timer-status role="status" aria-live="polite">Enter a target to begin.</p>
    </div>
  </div>
  <div class="mt-5 flex flex-wrap gap-3">
    <button type="submit" class="min-h-11 rounded-lg bg-leaf-500 px-5 text-sm font-bold text-ink-950" data-timer-start>Start timer</button>
    <button type="button" class="min-h-11 rounded-lg border border-leaf-500/35 px-5 text-sm font-bold text-leaf-300 disabled:cursor-not-allowed disabled:opacity-45" data-timer-pause disabled>Pause</button>
    <button type="button" class="min-h-11 rounded-lg border border-line px-5 text-sm font-bold text-sand-100" data-timer-reset>Reset</button>
  </div>
</form>

<script>import '../scripts/harvest-timer';</script>
