---
const production = import.meta.env.PROD;
---

<div data-analytics-consent data-production={String(production)} data-clarity-id="xsvg1uhfom">
  <section class="fixed inset-x-3 bottom-3 z-[70] mx-auto max-w-3xl rounded-2xl border border-leaf-500/35 bg-ink-950/98 p-4 shadow-2xl backdrop-blur sm:p-5" aria-labelledby="analytics-consent-title" data-analytics-consent-panel hidden>
    <div class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-center">
      <div>
        <p class="font-mono text-[10px] font-bold uppercase tracking-[.16em] text-leaf-400">Optional analytics</p>
        <h2 id="analytics-consent-title" class="mt-2 text-base font-bold text-white">Help improve these guides?</h2>
        <p class="mt-1 text-sm leading-6 text-sand-300">With permission, Microsoft Clarity records page interaction. Calculator values and seed selections are not sent by our event code. You can change this later in the footer.</p>
      </div>
      <div class="flex flex-col gap-2 sm:min-w-56">
        <button type="button" class="min-h-11 rounded-lg bg-leaf-500 px-4 text-sm font-bold text-ink-950" data-analytics-choice="allowed">Allow optional analytics</button>
        <button type="button" class="min-h-11 rounded-lg border border-line px-4 text-sm font-semibold text-white" data-analytics-choice="declined">Keep optional analytics off</button>
      </div>
    </div>
    <p class="mt-3 text-xs text-sand-300"><a href="/privacy/" class="underline hover:text-white">Read the privacy notice</a><span class="ml-3" data-analytics-consent-status role="status" aria-live="polite"></span></p>
  </section>
</div>

<script>import '../scripts/analytics-consent';</script>
