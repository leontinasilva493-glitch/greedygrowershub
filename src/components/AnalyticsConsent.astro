---
const production = import.meta.env.PROD;
---

<div data-analytics-consent data-production={String(production)} data-clarity-id="xsvg1uhfom">
  <section class="fixed inset-x-3 z-[70] mx-auto max-w-3xl rounded-2xl border border-leaf-500/35 bg-ink-950/98 p-3 shadow-2xl backdrop-blur sm:p-4" style="bottom: max(0.75rem, env(safe-area-inset-bottom));" aria-labelledby="analytics-consent-title" data-analytics-consent-panel hidden>
    <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-center">
      <div>
        <p class="font-mono text-[10px] font-bold uppercase tracking-[.16em] text-leaf-400">Optional analytics</p>
        <h2 id="analytics-consent-title" class="mt-1 text-sm font-bold text-white">Help improve these guides?</h2>
        <p class="mt-1 text-xs leading-5 text-sand-300">Optional Clarity recordings show where guides feel difficult. Calculator inputs stay private, and you can change this later.</p>
      </div>
      <div class="grid grid-cols-2 gap-2 sm:min-w-64">
        <button type="button" class="min-h-11 rounded-lg bg-leaf-500 px-3 text-sm font-bold text-ink-950" aria-label="Allow optional analytics" data-analytics-choice="allowed">Allow analytics</button>
        <button type="button" class="min-h-11 rounded-lg border border-line px-3 text-sm font-semibold text-white" aria-label="Keep optional analytics off" data-analytics-choice="declined">Keep off</button>
      </div>
    </div>
    <p class="mt-1 flex min-h-11 items-center text-xs text-sand-300"><a href="/privacy/" class="inline-flex min-h-11 items-center underline hover:text-white">Read the privacy notice</a><span class="ml-3" data-analytics-consent-status role="status" aria-live="polite"></span></p>
  </section>
</div>

<script>import '../scripts/analytics-consent';</script>
