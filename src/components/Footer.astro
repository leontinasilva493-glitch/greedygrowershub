---
import Icon from './Icon.astro';
import { site } from '../lib/content';
---

<footer class="border-t border-line bg-[#040b09]">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-[1.35fr_1fr_1fr_1fr] lg:px-8">
    <div><div class="flex items-center gap-2 text-leaf-400"><Icon name="sprout" /><span class="font-display font-bold text-white">Greedy Growers Hub</span></div><p class="mt-4 max-w-md text-sm leading-6 text-sand-300">Calculator-led player tools, community data snapshots, and evidence-labeled guides for the seed, harvest, and lightning loop.</p><p class="mt-5 text-xs leading-5 text-sand-300/70">Fan-made and not affiliated with Roblox or the Greedy Growers developers.</p></div>
    <div><p class="font-mono text-xs uppercase tracking-[.2em] text-leaf-400">Tools & data</p><ul class="mt-4 grid gap-3 text-sm text-sand-300"><li><a href="/" class="hover:text-white">Profit Calculator</a></li><li><a href="/seeds/" class="hover:text-white">Seed List</a></li><li><a href="/seeds/best-seeds/" class="hover:text-white">Best Seeds</a></li><li><a href="/codes/" class="hover:text-white">Codes Status</a></li><li><a href="/updates/" class="hover:text-white">Updates</a></li></ul></div>
    <div><p class="font-mono text-xs uppercase tracking-[.2em] text-leaf-400">Guides</p><ul class="mt-4 grid gap-3 text-sm text-sand-300"><li><a href="/beginner-guide/" class="hover:text-white">Beginner Guide</a></li><li><a href="/guides/get-money-fast/" class="hover:text-white">Get Money Fast</a></li><li><a href="/guides/progression/" class="hover:text-white">Progression Guide</a></li><li><a href="/guides/tickets/" class="hover:text-white">Tickets Guide</a></li></ul></div>
    <div><p class="font-mono text-xs uppercase tracking-[.2em] text-leaf-400">Mechanics & trust</p><ul class="mt-4 grid gap-3 text-sm text-sand-300"><li><a href="/mechanics/when-to-harvest/" class="hover:text-white">When to Harvest</a></li><li><a href="/mechanics/lightning/" class="hover:text-white">Lightning</a></li><li><a href={site.officialGameUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-white">Official Roblox page <Icon name="external" size={13} /></a></li><li><a href="/privacy/" class="hover:text-white">Privacy</a></li><li><a href="/disclaimer/" class="hover:text-white">Disclaimer</a></li><li><a href="/contact/" class="hover:text-white">Contact</a></li></ul></div>
  </div>
  <div class="border-t border-line/70 px-4 py-5 text-center font-mono text-[11px] uppercase tracking-[.16em] text-sand-300/60">© {new Date().getFullYear()} Greedy Growers Hub · Last editorial check {site.checkedAt}</div>
</footer>
